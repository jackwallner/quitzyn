    "Record one more craving to reveal more of your patterns.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record one more craving to reveal more of your patterns."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse noch ein Verlangen, um mehr über deine Muster zu erfahren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафиксируйте ещё один эпизод тяги, чтобы лучше понять закономерности."
          }
        },
        "cs": {
