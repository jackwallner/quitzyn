    "Bloom+ unlocks every species so you can switch your tree whenever you like. Your streak grows whichever one you pick.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ unlocks every species so you can switch your tree whenever you like. Your streak grows whichever one you pick."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ schaltet jede Baumart frei, damit du deinen Baum jederzeit wechseln kannst. Deine Serie wächst unabhängig von deiner Wahl weiter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ открывает все виды деревьев, чтобы вы могли менять бонсай когда угодно. Ваша серия растёт независимо от выбора."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ odemkne všechny druhy, abyste mohli kdykoli změnit strom. Vaše série poroste bez ohledu na to, který si vyberete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Bloom+ låser du upp alla arter och kan byta träd när du vill. Din svit växer oavsett vilket träd du väljer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ avaa kaikki puulajit, joten voit vaihtaa puuta milloin haluat. Päiväputkesi kasvaa valitsemastasi puusta riippumatta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met Bloom+ ontgrendel je alle soorten en kun je je boom wisselen wanneer je wilt. Je reeks groeit met elke soort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ desbloquea todas las especies para que cambies de árbol cuando quieras. Tu racha crece con cualquiera que elijas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ låser alle træsorter op, så du kan skifte træ, når du vil. Din serie vokser, uanset hvilket træ du vælger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ odblokowuje wszystkie gatunki bonsai, więc możesz zmieniać drzewko, kiedy chcesz. Niezależnie od wyboru twoja seria nadal rośnie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ odomkne všetky druhy bonsajov, takže môžeš stromček kedykoľvek zmeniť. Tvoja séria rastie bez ohľadu na výber."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ låser opp alle bonsaiartene, så du kan bytte tre når du vil. Rekken din vokser uansett hvilket du velger."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ deblochează toate speciile, ca să vă puteți schimba copacul oricând. Seria continuă să crească indiferent de copacul ales."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ відкриває доступ до всіх видів, тож ви можете будь-коли змінити дерево. Серія зростає незалежно від обраного дерева."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ sblocca tutte le specie, così puoi cambiare albero quando vuoi. La tua serie cresce con qualunque specie tu scelga."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ 解锁所有盆景品种，你可以随时更换。无论选择哪棵树，你的连续天数都会继续累积。"
          }
        }
      }
    },
