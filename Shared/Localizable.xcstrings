    "If today's nicotine-free, log it and water your garden.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If today's nicotine-free, log it and water your garden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du heute nikotinfrei bist, trag den Tag ein und gieße deinen Garten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сегодня нет никотина, заготовьте его и поливайте свой сад."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je dnes bez nikotinu, zapište to a zalévejte vaši zahradu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om dagens nikotinfria, logga den och vattna din trädgård."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos tänään ei ole nikotiinia, hirttäkää se ja kastelkaa puutarhanne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het vandaag nicotinevrij is, log dan in en geef water in je tuin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hoy está libre de nicotina, regístrelo y regala su jardín."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis dagens nikotinfri, så log det og vand din have."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli dziś nie ma nikotyny, zaloguj się i podlewaj ogród."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je dnes bez nikotínu, prihláste sa a zalejte záhradu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis dagens nikotinfri, logg den og vann din hage."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă azi e fără nicotină, logaţi-o şi udaţi-vă grădina."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо сьогодні немає нікотину, ввійдіть його і поливайте ваш сад."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se oggi è privo di nicotina, registrarlo e innaffiare il vostro giardino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果今天的尼古丁是无尼古丁的, 记录它和给您的花园取水。"
          }
        }
      }
    },
