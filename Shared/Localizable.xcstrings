    "%@ costs about %lld and a half days' worth of nicotine pouches.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostet etwa so viel wie %2$lld½ Tagesvorräte an Nikotinbeuteln."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ стоит примерно как никотиновые паучи за %2$lld с половиной дня."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stojí přibližně jako spotřeba nikotinových sáčků za %2$lld a půl dne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostar ungefär lika mycket som portionssnus för %2$lld och en halv dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ maksaa suunnilleen %2$lld½ päivän nikotiinipussien verran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kost ongeveer evenveel als nicotinezakjes voor %2$lld en een halve dag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cuesta aproximadamente lo mismo que %2$lld días y medio de bolsitas de nicotina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ koster omtrent det samme som nikotinposer til %2$lld en halv dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kosztuje mniej więcej tyle co saszetki nikotynowe na %2$lld i pół dnia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stojí približne toľko ako nikotínové vrecúška na %2$lld a pol dňa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ koster omtrent like mye som nikotinposer for %2$lld og en halv dag."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ costă cam cât pliculețele cu nicotină pentru %2$lld zile și jumătate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ коштує приблизно стільки ж, як нікотинові пакетики за %2$lld з половиною дня."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ costa più o meno quanto %2$lld giorni e mezzo di bustine di nicotina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的费用约等于 %2$lld 天半的尼古丁袋开销。"
          }
        }
      }
    },
