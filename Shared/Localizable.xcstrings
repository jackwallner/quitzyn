    "Stays in your pocket, not on pouches. Bloom+ keeps the streak that gets you there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld bleibt bei dir, statt in Nikotinbeutel zu fließen. Bloom+ hält dich auf Kurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти деньги остаются у вас, а не уходят на никотиновые паучи. Bloom+ помогает сохранить серию."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze zůstanou tobě místo toho, abys je utratil za nikotinové sáčky. Bloom+ ti pomáhá pokračovat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengarna stannar i fickan i stället för att gå till portionssnus. Bloom+ hjälper dig att hålla sviten vid liv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat jäävät sinulle, eivät nikotiinipusseihin. Bloom+ auttaa pitämään putken yllä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geld blijft in je zak in plaats van naar nicotinezakjes te gaan. Bloom+ helpt je je reeks vol te houden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero se queda contigo en vez de gastarse en bolsitas de nicotina. Bloom+ te ayuda a mantener la racha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengene bliver hos dig i stedet for at gå til nikotinposer. Bloom+ hjælper dig med at holde rækken kørende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pieniądze zostają u Ciebie zamiast trafiać na saszetki nikotynowe. Bloom+ pomaga utrzymać ciągłość."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Peniaze ti zostanú namiesto toho, aby si ich minul na nikotínové vrecúška. Bloom+ ti pomáha udržať sériu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengene blir i lomma i stedet for å gå til nikotinposer. Bloom+ hjelper deg å holde rekken gående."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Banii rămân la tine, în loc să se ducă pe pliculețe cu nicotină. Bloom+ te ajută să-ți păstrezi seria."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші залишаються у вас, а не йдуть на нікотинові пакетики. Bloom+ допомагає підтримувати серію."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I soldi restano a te, invece di finire in bustine di nicotina. Bloom+ ti aiuta a mantenere la serie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱留在你手里，而不是花在尼古丁袋上。Bloom+ 帮你延续这份坚持。"
          }
        }
      }
    },
