    "Your purchase is waiting for approval. Bloom+ unlocks on its own once it's confirmed, and you can keep using the free version meanwhile.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is waiting for approval. Bloom+ unlocks on its own once it's confirmed, and you can keep using the free version meanwhile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ entsperrt sich von selbst, sobald es bestätigt ist, und sie können die kostenlose version in der zwischenzeit weiter verwenden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша покупка ждет одобрения. Bloom+ разблокируется самостоятельно, как только она будет подтверждена, и вы можете продолжать использовать бесплатную версию."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš nákup čeká na schválení. Bloom+ odemyká sám, jakmile je potvrzeno, a vy můžete pokračovat pomocí bezplatné verze mezitím."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp väntar på godkännande. Bloom+ låser upp sig själv när det bekräftas, och du kan fortsätta använda den fria versionen under tiden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoksesi odottaa hyväksyntää. Bloom+ aukeaa itsestään, kun se on vahvistettu, ja voit jatkaa ilmaisen version käyttöä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw aankoop wacht op goedkeuring. Bloom+ ontgrendelt op zichzelf zodra het is bevestigd, en u kunt blijven gebruik maken van de gratis versie ondertussen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su compra está esperando la aprobación. Bloom+ se desbloquea por su cuenta una vez que esté confirmado, y puede seguir utilizando la versión gratuita mientras tanto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb venter på godkendelse. Bloom+ låser op på egen hånd, når det er bekræftet, og du kan fortsætte med at bruge den gratis version i mellemtiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zakup czeka na zatwierdzenie. Bloom+ odblokowuje się na własną rękę po potwierdzeniu, a w międzyczasie możesz używać darmowej wersji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš nákup čaká na schválenie. Bloom+ odomkne na vlastnú päsť, akonáhle sa potvrdí, a môžete naďalej používať bezplatnú verziu medzitým."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt kjøp venter på godkjenning. Bloom+ låses opp på egen hånd når det er bekreftet, og du kan fortsette å bruke den gratis versjonen i mellomtiden."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumpărarea dvs. este în așteptare pentru aprobare. Bloom+ descuie pe cont propriu odată ce este confirmat, și puteți continua să utilizați versiunea gratuită între timp."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка очікує на підтвердження. Коли її підтвердять, доступ до Bloom+ відкриється автоматично. А поки користуйтеся безкоштовною версією."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. Bloom+ si sblocca da solo una volta confermato, e si può continuare a utilizzare la versione gratuita nel frattempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的购买正在等待批准。 Bloom+ 一旦确认即可自动解锁, 您可以同时继续使用免费版本 。"
          }
        }
      }
    },
