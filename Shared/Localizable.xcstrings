    "See when your %@ hit, what sets them off, and how long yours actually last, plus the rest of Bloom+.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See when your %@ hit, what sets them off, and how long yours actually last, plus the rest of Bloom+."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir an, wann deine %1$@ auftreten, was sie auslöst und wie lange sie anhalten. Das und mehr gibt es in Bloom+."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, когда ваш %1$@ ударил, что их запускает, и как долго ваш фактически длится, плюс остальная часть Bloom+."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se, kdy vaše %1$@ hit, co je spustí, a jak dlouho vaše vlastně vydrží, plus zbytek Bloom+."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se när din %1$@ träff, vad sätter dem iväg, och hur länge din faktiskt varar, plus resten av Bloom+."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso kun %1$@ osuma, mikä käynnistää ne, ja kuinka kauan sinun todella kestää, plus loput Bloom+."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk wanneer je %1$@ raakt, wat hen aanzet, en hoe lang de jouwe eigenlijk duurt, plus de rest van Bloom+."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vea cuando su golpe %1$@, lo que los pone, y cuánto tiempo el suyo realmente dura, más el resto de Bloom+."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hvornår din %1$@ hit, hvad der sætter dem af, og hvor længe din faktisk vare, plus resten af Bloom+."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, kiedy twój %1$@ hit, co je uruchamia, i jak długo naprawdę trwa, plus reszta Bloom+."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozrite sa, kedy váš %1$@ hit, čo ich spustí, a ako dlho vlastne vydrží, plus zvyšok Bloom+."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se når din %1$@ hit, hva som setter dem av, og hvor lenge din faktisk vare, pluss resten av Bloom+."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi când apare %1$@, ce o declanșează și cât durează, plus restul Bloom+."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнайтеся, коли виникає %1$@, що його провокує та як довго він триває. Інші можливості Bloom+ теж доступні."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedere quando il vostro %1$@ ha colpito, che cosa li imposta, e quanto dura realmente il vostro, più il resto di Bloom+."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看你的%1$@何时出现、由什么引发、通常持续多久，以及 Bloom+ 的其他功能。"
          }
        }
      }
    },
