    "A lacy maple in warm autumn red and gold. Star-shaped leaves drift down as the days add up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lacy maple in warm autumn red and gold. Star-shaped leaves drift down as the days add up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein filigraner Ahorn in warmem Herbstrot und Gold. Sternförmige Blätter fallen, während die Tage zunehmen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кружевной клён в тёплых осенних красных и золотых тонах. Листья-звёзды опадают по мере того, как прибавляются дни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krajkový javor v teplé podzimní červené a zlaté. Hvězdicovité listy padají, jak přibývají dny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En lacy lönn i varm höst röd och guld. Star-formade blad glider ner när dagarna lägger upp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitsimäinen vaahtera lämpimän syksyn punaisessa ja kullassa. Tähdenmuotoiset lehdet leijuvat päivien kertyessä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een sierlijke esdoorn in warm herfstrood en goud. Stervormige bladeren dwarrelen neer terwijl de dagen verstrijken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arce de encaje en cálidos rojos y dorados otoñales. Sus hojas en forma de estrella caen según suman los días."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En lacy ahorn i varm efterårsrød og guld. Starformede blade glider ned som dagene tilføje op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koronkowy klon w ciepłej jesiennej czerwieni i złocie. Liście w kształcie gwiazd opadają, gdy przybywa dni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacy javor v teplej jesennej červenej a zlatej. Star-tvarované listy drift dole, ako dni sčítajú."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En spinkel lønn i varm høstrød og gull. Stjerneformede blader daler ned mens dagene går."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arțar delicat, în nuanțe de roșu și auriu. Frunzele în formă de stea cad pe măsură ce trec zilele."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мереживний клен у теплих осінніх червоних і золотих барвах. Листя-зірочки опадає, поки додаються дні."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acero delicato nei caldi rossi e ori d'autunno. Le foglie a stella cadono man mano che i giorni passano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暖秋红出一花花枫,相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去相去"
          }
        }
      }
    },
