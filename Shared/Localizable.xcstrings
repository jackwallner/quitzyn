    "Your first sprout has broken the soil.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first sprout has broken the soil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erster Keimling hat die Erde durchbrochen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш первый росток пробился из земли."
