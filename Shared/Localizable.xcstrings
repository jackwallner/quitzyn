    "Used to estimate the money, pouches, and nicotine you avoid while you stay nicotine-free.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Angaben helfen dabei, deine Ersparnisse sowie vermiedene Nikotinbeutel und Nikotinmengen zu schätzen, solange du nikotinfrei bleibst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти данные нужны, чтобы оценить сэкономленные деньги, а также количество паучей и никотина, от которых вы отказались, пока живёте без никотина."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto údaje slouží k odhadu ušetřených peněz a množství sáčků a nikotinu, kterým se vyhnete, když zůstanete bez nikotinu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används för att uppskatta hur mycket pengar och nikotin du sparar och hur många nikotinpåsar du undviker när du är nikotinfri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näiden tietojen avulla arvioidaan, kuinka paljon rahaa ja nikotiinia säästät ja kuinka monta nikotiinipussia jää käyttämättä, kun pysyt nikotiinittomana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gebruikt om te schatten hoeveel geld en nicotine je bespaart en hoeveel nicotinezakjes je vermijdt zolang je nicotinevrij blijft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para calcular cuánto dinero y cuántas bolsitas de nicotina ahorras, y cuánta nicotina evitas al mantenerte sin nicotina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges til at anslå, hvor mange penge og nikotinposer du sparer, og hvor meget nikotin du undgår, mens du er uden nikotin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane pomagają oszacować oszczędności na saszetkach oraz ilość nikotyny, której unikniesz, jeśli pozostaniesz bez nikotyny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocou týchto údajov odhadneme peniaze, vrecúška a nikotín, ktorým sa vyhneš, ak zostaneš bez nikotínu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukes til å anslå hvor mye penger og hvor mange nikotinposer du sparer, og hvor mye nikotin du unngår når du er nikotinfri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste date ajută la estimarea banilor economisiți, a pliculețelor evitate și a nicotinei neconsumate cât timp rămâneți fără nicotină."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допомагає оцінити заощаджені гроші, невикористані пакетики й нікотин, якого ви уникаєте, залишаючись без нікотину."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve a stimare i soldi risparmiati, le bustine evitate e la nicotina non assunta mentre resti senza nicotina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于估算你坚持无尼古丁期间省下的钱、少用的尼古丁袋和避免摄入的尼古丁。"
          }
        }
      }
    },
