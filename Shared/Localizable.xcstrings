    "Swap any species anytime · your streak keeps growing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap any species anytime · your streak keeps growing"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Art jederzeit wechseln · deine Serie wächst weiter"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте вид когда угодно · серия продолжает расти"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Druh můžete kdykoli změnit · série dál roste"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt art när du vill · sviten fortsätter växa"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda puulajia milloin vain · päiväputkesi kasvaa yhä"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel wanneer je wilt van soort · je reeks blijft groeien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de especie cuando quieras · tu racha sigue creciendo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift art når som helst · din serie vokser videre"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniaj gatunki, kiedy chcesz · twoja seria nadal rośnie"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedykoľvek zmeň druh bonsaja · tvoja séria rastie ďalej"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt art når du vil · rekken din fortsetter å vokse"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți oricând altă specie · seria continuă să crească"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюйте вид будь-коли · серія зростає далі"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia specie quando vuoi · la serie continua a crescere"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时更换盆景品种 · 连续天数照常累积"
          }
        }
      }
    },
