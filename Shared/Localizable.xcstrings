    "Log today and water your garden. You've got this.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log today and water your garden. You've got this."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag heute ein und gieß deinen Garten. Du schaffst das."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте сегодня и полейте сад. У вас получится."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapiš dnešek a zalij zahradu. Zvládneš to."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga idag och vattna din trädgård."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa tämä päivä ja kastele puutarhasi. Sinä pystyt tähän."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg vandaag vast en geef je tuin water. Jij kunt dit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra hoy y riega tu jardín. Tú puedes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log i dag og vand din have."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz dzisiaj i podlej ogród. Dasz radę."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihláste sa dnes a zalievajte záhradu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer dagen og vann hagen. Du klarer dette."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Log astazi si uda gradina."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте сьогодні й полийте сад. У вас вийде."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra oggi e annaffia il tuo giardino. Ce la fai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天记录一下,给花园浇水,你可以的"
          }
        }
      }
    },
    "Log today nicotine-free and water your bonsai": {
      "extractionState": "manual",
      "localizations": {
