    "%@ pouches you won't put in. That's nicotine your body never has to process.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pouches you won't put in. That's nicotine your body never has to process."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vermeidest %1$@ Nikotinbeutel. Dieses Nikotin muss dein Körper nicht verarbeiten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы избежали %1$@ никотиновых паучей. Этот никотин не придётся перерабатывать вашему организму."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhnete se použití %1$@ nikotinových sáčků. Vaše tělo nebude muset tento nikotin zpracovávat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nikotinpåsar du slipper använda. Då behöver kroppen aldrig ta hand om nikotinet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vältät %1$@ nikotiinipussia. Kehosi ei siis joudu käsittelemään niiden nikotiinia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vermijdt %1$@ nicotinezakjes. Je lichaam hoeft die nicotine niet te verwerken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitarás %1$@ bolsitas de nicotina. Tu cuerpo no tendrá que procesar esa nicotina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du undgår %1$@ nikotinposer. Så slipper kroppen for at behandle den nikotin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszczędzasz %1$@ saszetek nikotynowych. Organizm nie musi już przetwarzać tej nikotyny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhneš sa %1$@ nikotínovým vrecúškam. Tvoje telo tak nebude musieť spracovať tento nikotín."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du unngår %1$@ nikotinposer. Kroppen slipper dermed å omsette den nikotinen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu veți folosi %1$@ pliculețe cu nicotină. Organismul dvs. nu va mai avea de metabolizat acea nicotină."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не використаєте %1$@ нікотинових пакетиків. Організму не доведеться переробляти цей нікотин."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eviterai %1$@ bustine di nicotina. Il tuo corpo non dovrà metabolizzare quella nicotina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少用%1$@袋尼古丁，身体也就不必代谢这些尼古丁。"
          }
        }
      }
    },
