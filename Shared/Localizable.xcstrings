    "Every craving you rode out ended without a pouch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every craving you rode out ended without a pouch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Verlangen, das du überstanden hast, endete ohne Nikotinbeutel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая пережитая тяга закончилась без никотинового пауча."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé zvládnuté nutkání skončilo bez nikotinového sáčku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje sug du tog dig igenom tog slut utan en nikotinpåse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen läpikäymäsi mieliteko päättyi ilman nikotiinipussia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke drang die je doorstond, eindigde zonder nicotinezakje."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada deseo que superaste terminó sin una bolsita de nicotina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver trang, du kom igennem, endte uden en nikotinpose."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda silna chęć, którą udało ci się przetrwać, minęła bez saszetki nikotynowej."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé zvládnuté nutkanie sa skončilo bez nikotínového vrecúška."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert sug du kom deg gjennom, endte uten en nikotinpose."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare poftă peste care ai trecut s-a încheiat fără un pliculeț cu nicotină."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після кожного потягу вдалося обійтися без нікотинового пауча."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni impulso che hai superato è passato senza ricorrere a una bustina di nicotina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次你挺过冲动，都没有使用尼古丁袋。"
          }
        }
      }
    },
    "Every dollar and pouch you avoid, tracked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every dollar and pouch you avoid, tracked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder gesparte Euro und jeder vermiedene Nikotinbeutel wird erfasst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый доллар и мешок, которых вы избегаете, отслеживается."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý dolar a váček, kterému se vyhýbáš, sledoval."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje dollar och påse du undviker, spåras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäljität jokaisen dollarin ja pussin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke dollar en zak die je vermijd, gevolgd."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dólar y bolsa que evitas, rastreaste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver dollar og pose du undgår, sporet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy dolar i woreczek, którego unikasz, śledzony."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý dolár a vrecko, ktorému sa vyhneš, sledoval."
          }
        },
        "nb": {
