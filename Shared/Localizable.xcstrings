    "Branches are reaching wider. The shape is emerging.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Branches are reaching wider. The shape is emerging."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Äste greifen weiter aus. Die Form zeichnet sich ab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ветви раскидываются шире. Форма проявляется."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Větve sahají dál. Tvar se začíná rýsovat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenarna breder ut sig och trädets form börjar synas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oksat kasvavat leveämmiksi. Puun muoto alkaa hahmottua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De takken reiken verder naar buiten. De vorm begint zichtbaar te worden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ramas se extienden y la forma empieza a definirse."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenene breder sig, og træets form begynder at tage sig ud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gałęzie rozrastają się na boki, a drzewko nabiera kształtu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetvy sa rozrastajú do šírky a stromček získava svoj tvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Greinene strekker seg utover, og treet begynner å få form."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramurile se întind. Forma copacului prinde contur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гілки розростаються вшир. Форма дерева поступово вимальовується."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I rami si allargano e la forma dell’albero prende contorno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "枝条向外舒展，树形渐渐显现。"
          }
        }
      }
    },
