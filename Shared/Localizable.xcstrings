    "Keep your full garden, journal, and savings, or cancel any time before it renews.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your full garden, journal, and savings, or cancel any time before it renews."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deinen ganzen Garten, dein Tagebuch und deine Ersparnisse oder kündige jederzeit vor der Verlängerung."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните полный доступ к саду, дневнику и сбережениям. Отменить подписку можно в любое время до продления."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachovejte si plný přístup k zahradě, deníku i úsporám, nebo předplatné kdykoli před obnovením zrušte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll full tillgång till trädgården, dagboken och besparingarna, eller säg upp när du vill före förnyelsen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä puutarha, päiväkirja ja säästöt ennallaan tai peru tilaus milloin tahansa ennen sen uusiutumista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoud je hele tuin, dagboek en besparingen, of zeg op wanneer je wilt vóór de verlenging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva tu jardín, diario y ahorros, o cancela cuando quieras antes de la renovación."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold fuld adgang til haven, dagbogen og besparelserne, eller opsig når som helst før fornyelsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj cały ogród, dziennik i swoje oszczędności albo anuluj w dowolnym momencie przed odnowieniem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachovaj si celú záhradu, denník a úspory alebo zruš predplatné pred jeho obnovením."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold hele hagen, dagboken og besparelsene dine, eller avslutt før abonnementet fornyes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrați accesul complet la grădină, jurnal și economii sau anulați oricând înainte de reînnoire."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть повний сад, щоденник і заощадження або скасуйте підписку будь-коли до її поновлення."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il giardino completo, il diario e i risparmi, oppure annulla quando vuoi prima del rinnovo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留完整花园、日记和省钱记录，也可在续订前随时取消。"
          }
        }
      }
    },
