    "You've saved %@ while nicotine-free. Keep it growing with tools that support your progress.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$@ gespart, während du nikotinfrei bleibst. Mit Bloom+ kannst du deinen Fortschritt weiter unterstützen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставаясь без никотина, вы уже сэкономили %1$@. Bloom+ поможет вам продолжать."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Díky dnům bez nikotinu už máš ušetřeno %1$@. Bloom+ ti pomůže pokračovat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har sparat %1$@ genom att vara nikotinfri. Bloom+ hjälper dig att fortsätta framåt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet säästänyt %1$@ pysymällä nikotiinittomana. Bloom+ auttaa jatkamaan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt %1$@ bespaard door nicotinevrij te blijven. Bloom+ helpt je op koers te blijven."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has ahorrado %1$@ al mantenerte sin nicotina. Bloom+ te ayuda a seguir avanzando."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har sparet %1$@ ved at være nikotinfri. Bloom+ hjælper dig videre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udało Ci się zaoszczędzić %1$@, pozostając bez nikotyny. Bloom+ pomoże Ci iść dalej."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vďaka životu bez nikotínu máš ušetrené %1$@. Bloom+ ti pomáha pokračovať."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har spart %1$@ ved å være nikotinfri. Bloom+ hjelper deg videre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai economisit %1$@ rămânând fără nicotină. Bloom+ te ajută să continui."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишаючись без нікотину, ви заощадили %1$@. Bloom+ допомагає рухатися далі."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai risparmiato %1$@ restando senza nicotina. Bloom+ ti aiuta a continuare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坚持无尼古丁生活，你已省下%1$@。Bloom+ 助你继续前进。"
          }
        }
      }
    },
