    "Keep your full garden, journal, and savings, or cancel any time before it renews.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your full garden, journal, and savings, or cancel any time before it renews."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte Garten, Tagebuch und Ersparnisse oder kündige jederzeit vor der Verlängerung."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните сад, дневник и накопления или отмените до продления."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponech si celou zahradu, deník i úspory, nebo kdykoli před obnovením zruš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll din fulla trädgård, tidskrift och besparingar eller avbryta när som helst innan den förnyas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä koko puutarha, päiväkirja ja säästöt tai peru ennen uusimista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je tuin, dagboek en besparingen, of zeg op vóór de verlenging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva tu jardín, tu diario y tus ahorros, o cancela antes de la renovación."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold din fulde have, dagbog, og besparelser, eller annullere når som helst, før det fornyer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj ogród, dziennik i oszczędności albo anuluj przed odnowieniem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte svoju plnú záhradu, časopis a úspory, alebo zrušiť kedykoľvek predtým, než sa obnoví."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold hele hagen, dagboken og sparingen, eller avslutt før fornyelse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstraţi - vă grădina plină, jurnalul şi economiile sau anulaţi - le oricând înainte de a se reînnoi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть сад, щоденник і заощадження або скасуйте до подовження."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni giardino, diario e risparmi, oppure annulla prima del rinnovo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留你的花园、日记和积蓄 或在续约前取消任何时间"
          }
        }
      }
    },
    "Last 7 days: %lld. Previous 7 days: %lld.": {
      "extractionState": "manual",
