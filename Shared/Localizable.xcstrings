    "Switch anytime. Your day count and growth carry over to whichever tree you choose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch anytime. Your day count and growth carry over to whichever tree you choose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jederzeit wechseln. Deine Tage und dein Wachstum gehen auf den gewählten Baum über."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте дерево когда угодно. Счётчик дней и накопленный рост перейдут на выбранное вами дерево."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Strom můžete kdykoli změnit. Počet dnů i růst se přenesou na vybraný strom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt när du vill. Dina dagar och trädets tillväxt följer med till det träd du väljer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda puuta milloin vain. Päivälaskuri ja kasvu siirtyvät valitsemaasi puuhun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel wanneer je wilt. Je dagentelling en groei gaan mee naar de boom die je kiest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia cuando quieras. Tu cuenta de días y el crecimiento se mantienen con el árbol que elijas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift når som helst. Dine dage og træets vækst følger med til det træ, du vælger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniaj drzewko w dowolnej chwili. Licznik dni i dotychczasowy wzrost zostaną zachowane przy każdym wyborze."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stromček môžeš zmeniť kedykoľvek. Počet dní aj jeho rast sa prenesú na každý stromček, ktorý si vyberieš."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt når du vil. Dagstelleren og veksten følger med til treet du velger."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți schimba oricând copacul. Numărul de zile și creșterea se transferă la copacul ales."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюйте дерево будь-коли. Кількість днів і приріст переносяться на вибране вами дерево."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia quando vuoi. Il conteggio dei giorni e la crescita passano all’albero che scegli."
          }
        },
