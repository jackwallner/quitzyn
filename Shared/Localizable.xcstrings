    "Swap any species anytime · your streak keeps growing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap any species anytime · your streak keeps growing"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arten jederzeit tauschen · deine Serie wächst weiter"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте вид когда угодно · серия продолжает расти"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měň druhy kdykoli · série dál roste"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byta någon art när som helst - din streak fortsätter att växa"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda lajia milloin vain · putki kasvaa yhä"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel altijd van soort · je reeks blijft groeien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de especie cuando quieras · tu racha sigue creciendo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap enhver art når som helst · din streak holder vokser"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniaj gatunek, kiedy chcesz · seria dalej rośnie"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap akýkoľvek druh kedykoľvek · vaša séria stále rastie"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt art når du vil · rekken fortsetter å vokse"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimba orice specie oricand · dunga ta continua sa creasca"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюйте вид будь-коли · серія росте далі"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
