    "You don't have to do anything else right now. Just stay here and breathe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have to do anything else right now. Just stay here and breathe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst gerade nichts anderes tun. Bleib einfach hier und atme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас больше ничего делать не нужно. Просто побудьте здесь и дышите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď nemusíš dělat nic jiného. Jen tu zůstaň a dýchej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behöver inte göra något annat just nu. Bara stanna här och andas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinun ei tarvitse tehdä nyt mitään muuta. Pysy vain tässä ja hengitä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hoeft nu niets anders te doen. Blijf gewoon hier en adem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no tienes que hacer nada más. Solo quédate aquí y respira."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behøver ikke gøre andet lige nu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz nie musisz robić nic więcej. Po prostu zostań tu i oddychaj."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemusíš robiť nič iné."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du trenger ikke gjøre noe annet nå. Bare bli her og pust."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu trebuie să faci nimic altceva acum."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз більше нічого робити не треба. Просто побудьте тут і дихайте."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adesso non devi fare nient'altro. Resta qui e respira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在不用再做别的事了 待在这里呼吸"
          }
        }
      }
    },
