        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder nikotinfreie Tag lässt deinen Baum wachsen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый день без никотина помогает вашему дереву расти."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý den bez nikotinu pomáhá růstu vašeho stromu."
