    "It's already smaller than it was a minute ago, even if it doesn't feel finished.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's already smaller than it was a minute ago, even if it doesn't feel finished."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verlangen ist schon schwächer als vor einer Minute, auch wenn es sich noch nicht so anfühlt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она уже слабее, чем минуту назад, даже если кажется, что не прошла."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už je menší než před minutou, i když to ještě nepůsobí jako konec."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Suget är redan svagare än för en minut sedan, även om det inte känns över än."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on jo pienempi kuin minuutti sitten, vaikkei se tunnu ohi olevan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nicotinetrek is nu al minder sterk dan een minuut geleden, ook al voelt het nog niet voorbij."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ansias ya son menos intensas que hace un minuto, aunque no parezca que hayan terminado."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotintrangen er allerede svagere end for et minut siden, selvom den ikke føles helt ovre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głód nikotynowy jest już słabszy niż minutę temu, nawet jeśli jeszcze nie minął."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuť na nikotín je už slabšia než pred minútou, aj keď ešte celkom neustúpila."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotinsuget er allerede svakere enn for ett minutt siden, selv om det ikke føles helt over."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este deja mai slabă decât acum un minut, chiar dacă nu pare să fi trecut complet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяг уже слабший, ніж хвилину тому, навіть якщо ще здається, що він не минув."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voglia è già più lieve rispetto a un minuto fa, anche se non sembra passata del tutto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使你还觉得它没结束，这阵渴求也已比一分钟前减轻。"
          }
        }
      }
    },
    "It's okay. A slip is part of a lot of journeys, and logging it keeps the rest of your record honest.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's okay. A slip is part of a lot of journeys, and logging it keeps the rest of your record honest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist in Ordnung. Viele erleben auf ihrem Weg Ausrutscher. Wenn du ihn einträgst, bleibt dein Verlauf ehrlich."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё в порядке. На пути к отказу от никотина у многих случаются срывы. Если отметить его, остальная история останется точной."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To je v pořádku. Na cestě k životu bez nikotinu se uklouznutí stává mnoha lidem. Když ho zaznamenáte, zbytek záznamu bude odpovídat skutečnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är okej. Många gör ett snedsteg längs vägen. Om du registrerar det förblir resten av din historik korrekt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei se mitään. Retkahdus kuuluu monen matkaan, ja sen kirjaaminen pitää muun historiasi paikkansapitävänä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is oké. Een misstap hoort bij veel trajecten. Door die te registreren blijft de rest van je geschiedenis kloppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está bien. Un desliz forma parte de muchos caminos. Registrarlo ayuda a que el resto de tu historial sea fiel a lo ocurrido."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er okay. En smutter er en del af mange forløb. Når du registrerer den, forbliver resten af din historik retvisende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To w porządku. Potknięcia zdarzają się na drodze do zmiany, a ich zapisanie pozwala rzetelnie śledzić dalsze postępy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To je v poriadku. Pošmyknutie patrí k mnohým cestám. Keď ho zaznamenáš, zvyšok tvojej histórie zostane presný."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går bra. En glipp er en del av mange endringsreiser. Når du registrerer den, blir resten av historikken din riktig."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este în regulă. O scăpare face parte din parcursul multor persoane, iar înregistrarea ei păstrează restul istoricului dvs. corect."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе гаразд. Зриви трапляються на багатьох шляхах. Позначивши цей зрив, ви збережете точність решти історії."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va bene. Uno scivolone capita in molti percorsi. Registrarlo mantiene accurato il resto della tua cronologia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没关系。很多人的戒断过程中都会有一次失手。记录下来，可以让其余的记录保持准确。"
          }
        }
      }
    },
