    "Almost through. Whatever's left of it is on its way out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost through. Whatever's left of it is on its way out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast geschafft. Was noch da ist, klingt schon ab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти всё. То, что осталось, уже уходит."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoro hotovo. Co z ní zbylo, už odchází."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästan genom. Vad som än är kvar av det är på väg ut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Melkein ohi. Se mitä on jäljellä, on jo lähdössä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna erdoorheen. Wat er nog over is, is op weg naar buiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi lo logras. Lo que queda ya se está yendo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, der er tilbage, er på vej ud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawie po wszystkim. To, co zostało, już odchodzi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čokoľvek z toho zostalo je na ceste von."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesten gjennom. Det som er igjen, er på vei ut."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Orice a mai rămas din el e pe cale să iasă."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майже все. Те, що лишилося, вже минає."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi finito. Quel che resta se ne sta andando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "差不多了 剩下的东西都出来了"
          }
        }
      }
    },
