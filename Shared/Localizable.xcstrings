    "A slip can only be taken back while it's the most recent one on your record.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A slip can only be taken back while it's the most recent one on your record."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ausrutscher lässt sich nur zurücknehmen, solange er der neueste ist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срыв можно отменить, только пока он самый последний."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklouznutí jde vrátit jen tehdy, když je ve tvém záznamu nejnovější."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett snedsteg kan bara ångras så länge det är det senaste i din historik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipsahduksen voi perua vain, jos se on tuorein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een uitglijder kun je alleen terugdraaien als het de meest recente is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo puedes deshacer un desliz si es el más reciente de tu historial."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et fejltrin kan kun fortrydes, så længe det er det senest registrerede."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potknięcie można cofnąć tylko wtedy, gdy jest najnowsze."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakopnutie môžete vrátiť späť, len kým je najnovšie v zázname."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En sprekk kan bare angres så lenge den er den nyeste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți anula un episod de consum doar cât timp este cel mai recent înregistrat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зрив можна скасувати, лише поки він останній."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno scivolone si può annullare solo se è il più recente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有最新记录的失手才能撤销。"
          }
        }
      }
    },
