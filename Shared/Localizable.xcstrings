    "Stays in your pocket, not on pouches. Bloom+ keeps the streak that gets you there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld bleibt bei dir, statt in Nikotinbeutel zu fließen. Bloom+ hilft dir, deine Serie im Blick zu behalten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги остаются у вас, а не уходят на никотиновые паучи. Bloom+ помогает следить за серией, которая приведёт вас к цели."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze vám zůstanou, místo abyste je utráceli za nikotinové sáčky. Bloom+ vám pomáhá udržet si přehled o sérii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengarna stannar i fickan i stället för att gå till nikotinpåsar. Bloom+ hjälper dig att hålla sviten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat jäävät taskuusi sen sijaan, että kuluisivat nikotiinipusseihin. Bloom+ auttaa pitämään päiväputkesi yllä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geld blijft in je zak in plaats van naar nicotinezakjes te gaan. Bloom+ helpt je reeks vol te houden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero se queda contigo en vez de gastarse en bolsitas de nicotina. Bloom+ te ayuda a mantener la racha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengene bliver hos dig i stedet for at gå til nikotinposer. Bloom+ hjælper dig med at holde serien i gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pieniądze zostają u ciebie zamiast trafiać na saszetki nikotynowe. Bloom+ pomaga utrzymać serię, dzięki której możesz oszczędzać."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Peniaze ti zostanú namiesto toho, aby si ich minul na nikotínové vrecúška. Bloom+ ti pomáha udržať sériu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengene blir i lomma i stedet for å gå til nikotinposer. Bloom+ hjelper deg med å holde rekken gående."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Banii vă rămân în buzunar, nu se duc pe pliculețe cu nicotină. Bloom+ vă ajută să vă păstrați seria."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші залишаються у вашій кишені, а не йдуть на пакетики. Bloom+ допомагає зберігати серію."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I soldi restano in tasca, invece di finire nelle bustine. Bloom+ ti aiuta a mantenere la serie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱留在你口袋里，不再花在尼古丁袋上。Bloom+ 帮你延续这份坚持。"
          }
        }
      }
    },
