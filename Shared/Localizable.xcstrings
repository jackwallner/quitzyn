    "Who supported me today, even in a small way?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who supported me today, even in a small way?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer hat mich heute unterstützt, und sei es nur ein bisschen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто поддержал меня сегодня, хотя бы немного?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdo mě dnes podpořil, třeba i maličkostí?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem stödde mig idag, även på ett litet sätt?"
