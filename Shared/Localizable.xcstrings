    "%@ costs about %lld and a half days' worth of nicotine pouches.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostet etwa so viel wie Nikotinbeutel für %2$lld½ Tage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ стоит примерно как никотиновые паучи на %2$lld с половиной дня."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stojí přibližně tolik co nikotinové sáčky na %2$lld a půl dne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostar ungefär lika mycket som nikotinpåsar för %2$lld och en halv dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ maksaa suunnilleen %2$lld ja puolen päivän nikotiinipussien hinnan verran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kost ongeveer evenveel als nicotinezakjes voor %2$lld en een halve dag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cuesta aproximadamente lo mismo que las bolsitas de nicotina de %2$lld días y medio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisen på %1$@ svarer til det, du ville bruge på nikotinposer i %2$lld dage plus en halv dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena %1$@ odpowiada mniej więcej wydatkom na saszetki nikotynowe przez %2$lld i pół dnia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena %1$@ zodpovedá približne výdavkom na nikotínové vrecúška za %2$lld a pol dňa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisen på %1$@ tilsvarer omtrent det du bruker på nikotinposer i %2$lld og en halv dag."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ costă cât pliculețele cu nicotină pentru aproximativ %2$lld zile și jumătate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ коштує приблизно стільки ж, скільки нікотинові пакетики за %2$lld з половиною доби."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ costa più o meno quanto le bustine di nicotina per %2$lld giorni e mezzo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@约相当于%2$lld天半的尼古丁袋费用。"
          }
        }
      }
    },
