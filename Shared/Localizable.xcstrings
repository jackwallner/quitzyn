    "An evergreen pine with cloud-like needle tiers and a gnarled, weathered trunk.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An evergreen pine with cloud-like needle tiers and a gnarled, weathered trunk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine immergrüne Kiefer mit etagenweise angeordneten, wolkenförmigen Nadelpolstern und einem knorrigen, verwitterten Stamm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечнозелёная сосна с ярусами хвои, похожими на облака, и узловатым обветренным стволом."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stálezelená borovice s patry jehlic jako mraky a sukovitým, ošlehaným kmenem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En städsegrön tall med molnformade lager av barr och en vindpinad, knotig stam."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikivihreä mänty pilvimäisine neulaskerroksineen ja kyhmyisine, sään pieksemine runkoineen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een groenblijvende den met wolkachtige naaldlagen en een knoestige, verweerde stam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pino perenne con capas de agujas como nubes y un tronco nudoso y curtido."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En stedsegrøn fyr med skylignende lag af nåle og en knudret, vejrbidt stamme."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zimozielona sosna o warstwowej koronie z igieł przypominającej chmury i sękatym, naznaczonym przez czas pniu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždyzelená borovica s poschodiami ihličia pripomínajúcimi oblaky a s pokrúteným, časom ošľahaným kmeňom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En eviggrønn furu med lag av nåler som skyer og en krokete, værbitt stamme."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pin veșnic verde, cu ace dispuse în straturi ca norii și cu un trunchi noduros, modelat de vreme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вічнозелена сосна з ярусами хвої, схожими на хмари, та вузлуватим стовбуром, обвітреним часом."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pino sempreverde, con nuvole di aghi a strati e un tronco nodoso e segnato dal tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常青松树，针叶层层如云，树干盘曲苍劲、饱经风霜。"
          }
        }
      }
    },
