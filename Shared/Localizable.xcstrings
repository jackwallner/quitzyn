    "A flowering sakura wrapped in soft pink bloom. Petals drift down as your streak grows.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A flowering sakura wrapped in soft pink bloom. Petals drift down as your streak grows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine blühende Sakura in zartem Rosa. Blütenblätter fallen, während deine Serie wächst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цветущая сакура в нежно-розовом цвету. Лепестки опадают по мере роста серии."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvetoucí sakura zahalená do jemně růžových květů. S tvou sérií padají okvětní lístky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En blommande sakura insvept i mjuk rosa blom. Petals glider ner när din streak växer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukkiva sakura pehmeän vaaleanpunaisen kukinnan peitossa. Terälehdet leijuvat putkesi kasvaessa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bloeiende sakura in zacht roze bloesem. Blaadjes dwarrelen neer terwijl je reeks groeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sakura en flor envuelto en un rosa suave. Los pétalos caen mientras crece tu racha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En blomstrende sakura pakket ind i blød pink flor. Petaler glider ned som din stime vokser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwitnąca sakura w delikatnym różu. Płatki opadają, gdy rośnie twoja seria."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvitnúca sakura zabalená do mäkkého ružového kvetu. Kvety drift dole, ako vaša séria rastie."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En blomstrende sakura i myk rosa. Kronbladene daler ned mens rekken vokser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cireș sakura înflorit, acoperit de flori roz delicate. Petalele cad pe măsură ce crește seria ta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Квітуча сакура в ніжно-рожевому цвіті. Пелюстки опадають, поки росте серія."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sakura in fiore avvolto in un rosa delicato. I petali cadono mentre la serie cresce."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鲜花樱花被软粉色花朵所包裹 花瓣随花朵的花朵而飘来"
          }
        }
      }
    },
