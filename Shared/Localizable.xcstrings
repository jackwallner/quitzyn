    "You don't have to do anything else right now. Just stay here and breathe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have to do anything else right now. Just stay here and breathe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst gerade nichts anderes tun. Bleib einfach hier und atme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас больше ничего делать не нужно. Просто побудьте здесь и дышите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď nemusíte dělat nic dalšího. Zůstaňte tady a dýchejte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behöver inte göra något annat just nu. Bara stanna här och andas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinun ei tarvitse tehdä nyt mitään muuta. Pysy vain tässä ja hengitä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hoeft nu niets anders te doen. Blijf hier en adem rustig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes que hacer nada más ahora. Quédate aquí y respira."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behøver ikke gøre mere lige nu. Bliv her, og træk vejret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie musisz teraz nic więcej robić. Zostań tu i oddychaj."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz nemusíš robiť nič viac. Zostaň tu a dýchaj."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du trenger ikke gjøre noe mer akkurat nå. Bare bli her og pust."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu trebuie să faceți nimic altceva acum. Rămâneți aici și respirați."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз вам не потрібно більше нічого робити. Просто залишайтеся тут і дихайте."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non devi fare altro adesso. Resta qui e respira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在不必做别的，只要留在这里，慢慢呼吸。"
          }
        }
      }
    },
