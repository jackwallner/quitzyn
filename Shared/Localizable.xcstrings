    "What does being nicotine-free give me that nicotine never could?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does being nicotine-free give me that nicotine never could?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was gibt mir ein Leben ohne Nikotin, was Nikotin mir nie geben konnte?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что мне даёт жизнь без никотина, чего никотин никогда не мог дать?"
          }
        },
        "cs": {
          "stringUnit": {
