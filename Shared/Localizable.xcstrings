    "The seed is settling in. Your journey starts here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The seed is settling in. Your journey starts here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Samen findet seinen Platz. Hier beginnt dein Weg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семя приживается. Ваш путь начинается здесь."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Semínko se zabydluje. Tvoje cesta začíná tady."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fröet går in. Din resa börjar här."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siemen asettuu paikoilleen. Matkasi alkaa tästä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zaadje zet zich vast. Hier begint je reis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La semilla se está asentando. Tu camino empieza aquí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæden er ved at falde til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasionko się zadomawia. Twoja droga zaczyna się tutaj."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Semeno sa usadilo, vaša cesta začína tu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frøet finner seg til rette. Reisen din starter her."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sămânţa se stabileşte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насінина приживається. Ваш шлях починається тут."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il seme si sta ambientando. Il tuo percorso inizia qui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "种子落地了 你的旅程从这里开始"
          }
        }
      }
    },
    "This is near the top of it. These %@ climb fast and then they stop climbing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is near the top of it. These %@ climb fast and then they stop climbing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese %1$@ klettern schnell und dann hören sie auf zu klettern."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это рядом с вершиной. Эти %1$@ быстро поднимаются, а затем они перестают подниматься."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To je blízko vrcholu. Tyto %1$@ vylézt rychle a pak přestat šplhat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är nära toppen av det. Dessa %1$@ klättrar snabbt och sedan slutar de klättra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on lähellä sitä. Nämä %1$@ kiipeävät nopeasti ja sitten ne lakkaavat kiipeämästä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is nabij de top. Deze %1$@ klimmen snel en dan stoppen ze met klimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto está cerca de la cima. Estos %1$@ escalan rápido y luego dejan de escalar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er tæt på toppen af det. Disse %1$@ klatre hurtigt, og så stopper de med at klatre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te %1$@ szybko się wspinają i przestają się wspinać."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To je v blízkosti vrcholu. Tieto %1$@ šplhať rýchlo a potom prestanú šplhať."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er nær toppen av det. Disse %1$@ klatre raskt og deretter slutter de å klatre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru este aproape de partea de sus a acesteia. Acestea %1$@ urca rapid și apoi se opresc alpinism."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це біля вершини його. Ці %1$@ швидко сходження, а потім припиняють скелелазіння."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è vicino alla cima di esso. Questi %1$@ salire veloce e poi smettere di arrampicarsi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这通常接近高峰。%1$@会迅速增强，随后逐渐减弱。"
          }
        }
      }
    },
