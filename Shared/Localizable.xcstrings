    "Ancient and weathered. This tree has seen a lot.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancient and weathered. This tree has seen a lot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uralt und verwittert. Dieser Baum hat viel erlebt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Древний и обветренный. Это дерево многое повидало."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prastará a ošlehaná. Tenhle strom už toho zažil hodně."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här trädet har sett mycket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikivanha ja sään kuluttama. Tämä puu on nähnyt paljon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oeroud en verweerd. Deze boom heeft veel meegemaakt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancestral y curtido. Este árbol ha visto mucho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette træ har set meget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pradawne i ogorzałe. To drzewo wiele widziało."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento strom videl veľa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eldgammel og værbitt. Dette treet har sett mye."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copacul ăsta a văzut multe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прадавній і обвітрений. Це дерево багато бачило."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Antico e segnato dal tempo. Quest'albero ne ha viste tante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "古老而风化,这棵树见过很多次"
          }
        }
      }
    },
