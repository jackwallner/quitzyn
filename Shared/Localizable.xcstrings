    "%@ pouches you won't put in. That's nicotine your body never has to process.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pouches you won't put in. That's nicotine your body never has to process."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sparst %1$@ Nikotinbeutel. Dieses Nikotin muss dein Körper nicht verarbeiten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты избежал использования %1$@ никотиновых пакетиков. Твоему организму не придётся перерабатывать этот никотин."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhneš se použití %1$@ nikotinových sáčků. Tvoje tělo tak nemusí zpracovat tento nikotin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du undviker %1$@ portioner snus. Då slipper kroppen ta hand om den nikotinen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vältät %1$@ nikotiinipussia. Kehosi ei siis tarvitse käsitellä niiden nikotiinia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vermijdt %1$@ nicotinezakjes. Je lichaam hoeft die nicotine dus niet te verwerken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitarás %1$@ bolsitas de nicotina. Tu cuerpo no tendrá que procesar esa nicotina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du undgår %1$@ nikotinposer. Så skal kroppen ikke behandle den nikotin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikasz %1$@ saszetek nikotynowych. Organizm nie będzie musiał przetwarzać tej nikotyny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhneš sa použitiu %1$@ nikotínových vrecúšok. Tvoje telo tak nemusí spracovať tento nikotín."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du unngår %1$@ nikotinposer. Kroppen slipper dermed å behandle den nikotinen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eviți folosirea a %1$@ pliculețe cu nicotină. Corpul tău nu va trebui să proceseze acea nicotină."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти уникнеш використання %1$@ нікотинових пакетиків. Організму не доведеться переробляти цей нікотин."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eviterai %1$@ bustine di nicotina. Il tuo corpo non dovrà elaborare quella nicotina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将避免使用%1$@袋尼古丁，身体也就不必处理这些尼古丁。"
          }
        }
      }
    },
