    "Refined and dense. The work of real patience.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refined and dense. The work of real patience."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfeinert und dicht. Das Werk echter Geduld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сформированный и густой. Результат долгого терпения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytříbená a hustá. Dílo skutečné trpělivosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välformad och tät. Ett resultat av stort tålamod."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hienostunut ja tiheä. Pitkän kärsivällisyyden tulos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfijnd en dicht vertakt. Het resultaat van veel geduld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Refinado y frondoso. El resultado de mucha paciencia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forfinet og tæt. Resultatet af stor tålmodighed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopracowane i gęste. Widać w nim prawdziwą cierpliwość."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hustý a vycibrený, výsledok trpezlivej práce."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Raffinert og tett. Resultatet av ekte tålmodighet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafinat și dens. Rezultatul unei răbdări îndelungate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витончений і густий. Результат справжнього терпіння."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raffinato e fitto. Frutto di tanta pazienza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "枝叶细密，形态精致，尽显耐心。"
          }
        }
      }
    },
