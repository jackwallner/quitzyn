    "Notice it without arguing with it. You're not trying to win, you're waiting it out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice it without arguing with it. You're not trying to win, you're waiting it out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm das Verlangen wahr, ohne dagegen anzukämpfen. Du musst nichts gewinnen, sondern kannst abwarten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замечайте её, не споря с ней. Вы не пытаетесь победить, вы её пережидаете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnímejte nutkání bez boje. Nemusíte zvítězit, stačí počkat, až odezní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg märke till suget utan att argumentera med det. Du behöver inte vinna, bara vänta ut det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huomaa nikotiininhimo väittelemättä sen kanssa. Sinun ei tarvitse voittaa sitä, riittää että odotat sen ohi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk de nicotinetrek op zonder ermee in discussie te gaan. Je hoeft niet te winnen, alleen af te wachten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota las ansias sin discutir con ellas. No se trata de ganar, sino de esperar a que pasen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg mærke til nikotintrangen uden at diskutere med den. Du behøver ikke vinde, bare vente på at den går over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zauważ głód nikotynowy, nie wdając się z nim w walkę. Nie musisz wygrać, wystarczy, że go przeczekasz."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všimni si chuť na nikotín bez toho, aby si s ňou bojoval. Nemusíš zvíťaziť, stačí ju prečkať."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg merke til nikotinsuget uten å krangle med det. Du trenger ikke å vinne, bare å vente det ut."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Observați pofta fără să vă luptați cu ea. Nu trebuie să o învingeți, doar să așteptați să treacă."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помічайте потяг, не сперечаючись із ним. Не потрібно перемагати його, просто дочекайтеся, поки він мине."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota la voglia senza contrastarla. Non devi vincere, devi solo aspettare che passi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留意这种感觉，不必和它较劲。你不需要战胜它，只要等它过去。"
          }
        }
      }
    },
    "Notifications are turned off for Quit Zyn, so the reminder can't be delivered. Tap above to enable them in the Settings app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off for Quit Zyn, so the reminder can't be delivered. Tap above to enable them in the Settings app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen für Quit Zyn sind ausgeschaltet, daher kann die Erinnerung nicht zugestellt werden. Tippe oben, um sie in den Einstellungen zu aktivieren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления Quit Zyn отключены, поэтому напоминание не доставляется. Нажмите выше, чтобы включить уведомления в приложении «Настройки»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení pro Quit Zyn jsou vypnutá, takže připomenutí nelze doručit. Klepněte výše a povolte je v aplikaci Nastavení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser är avstängda för Quit Zyn, så påminnelsen kan inte skickas. Tryck ovan för att slå på dem i Inställningar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Zynin ilmoitukset ovat pois päältä, joten muistutusta ei voida lähettää. Napauta yllä olevaa kohtaa ja ota ilmoitukset käyttöön Asetuksissa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen voor Quit Zyn staan uit, dus de herinnering kan niet worden bezorgd. Tik hierboven om meldingen in Instellingen in te schakelen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de Quit Zyn están desactivadas, así que no recibirás el recordatorio. Toca arriba para activarlas en Ajustes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer for Quit Zyn er slået fra, så påmindelsen ikke kan sendes. Tryk ovenfor for at slå dem til i Indstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia aplikacji Quit Zyn są wyłączone, więc przypomnienie nie może dotrzeć. Stuknij powyżej, aby włączyć je w Ustawieniach."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenia aplikácie Quit Zyn sú vypnuté, preto ti pripomienka nepríde. Ťukni vyššie a zapni ich v Nastaveniach."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslinger for Quit Zyn er slått av, så påminnelsen kan ikke sendes. Trykk ovenfor for å slå dem på i Innstillinger."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările pentru Quit Zyn sunt dezactivate, așa că mementoul nu poate fi trimis. Atingeți mai sus pentru a le activa în Configurări."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення для Quit Zyn вимкнено, тому нагадування не надійде. Торкніться вище, щоб увімкнути їх у Параметрах."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di Quit Zyn sono disattivate, quindi il promemoria non può arrivare. Tocca sopra per attivarle in Impostazioni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Zyn 的通知已关闭，因此无法发送提醒。点按上方按钮，在“设置”中开启通知。"
          }
        }
      }
    },
