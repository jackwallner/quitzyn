    "Ride it out with a few minutes of breathing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ride it out with a few minutes of breathing"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überstehe das Verlangen mit ein paar Minuten Atemübungen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переждите тягу, спокойно подышав пару минут"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přečkejte nutkání s několika minutami klidného dýchání"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta dig igenom suget med några minuters andning"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selätä nikotiininhimo hengittämällä rauhallisesti muutaman minuutin ajan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom door de nicotinetrek heen met een paar minuten rustig ademhalen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que pase mientras respiras con calma unos minutos"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom igennem nikotintrangen med et par minutters rolig vejrtrækning"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczekaj głód nikotynowy, spokojnie oddychając przez kilka minut"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prečkaj chuť na nikotín pár minútami pokojného dýchania"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom deg gjennom nikotinsuget med noen minutters rolig pusting"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Respirați câteva minute, până trece pofta"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перечекайте потяг, спокійно подихавши кілька хвилин."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspetta che passi, respirando con calma per qualche minuto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用几分钟呼吸练习，陪自己度过这阵渴求"
          }
        }
      }
