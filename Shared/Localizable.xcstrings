    "%@ Keep the full garden, or cancel any time before it renews.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Keep the full garden, or cancel any time before it renews."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Behalte den ganzen Garten oder kündige jederzeit vor der Verlängerung."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Сохраните весь сад или отмените в любой момент до продления."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Zachovejte si celou zahradu nebo předplatné kdykoli před obnovením zrušte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Behåll hela trädgården. Säg upp när du vill före förnyelsen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Pidä koko puutarha tai peru milloin vain ennen uusimista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Behoud je hele tuin of zeg op wanneer je wilt, vóór de verlenging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Conserva el jardín completo o cancela cuando quieras antes de la renovación."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Behold fuld adgang til haven, eller opsig når som helst før fornyelsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Zachowaj cały ogród albo anuluj w dowolnym momencie przed odnowieniem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Zachovaj si celú záhradu alebo zruš predplatné pred jeho obnovením."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Behold hele hagen, eller avslutt når som helst før abonnementet fornyes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Păstrați grădina completă sau anulați oricând înainte de reînnoire."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Збережіть повний сад або скасуйте підписку будь-коли до її поновлення."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Mantieni il giardino completo o annulla quando vuoi prima del rinnovo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@保留完整花园，也可在续订前随时取消。"
          }
        }
      }
    },
