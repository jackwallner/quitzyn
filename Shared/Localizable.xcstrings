    "Two quick questions while it's fresh. Both optional.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two quick questions while it's fresh. Both optional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei kurze Fragen, solange es frisch ist. Beide freiwillig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два коротких вопроса, пока впечатления свежи. Отвечать необязательно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvě krátké otázky, dokud máte vše v čerstvé paměti. Odpovědi jsou dobrovolné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två snabba frågor medan du minns. Båda är frivilliga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi nopeaa kysymystä, kun asia on tuoreessa muistissa. Molemmat ovat vapaaehtoisia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee korte vragen nu het nog vers in je geheugen zit. Beide zijn optioneel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos preguntas rápidas mientras lo tienes presente. Ambas son opcionales."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To hurtige spørgsmål, mens det stadig står klart. Begge er valgfrie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa krótkie pytania, póki wszystko jest świeże. Odpowiedzi są opcjonalne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kým si to ešte pamätáš, odpovedz na dve krátke otázky. Obe sú dobrovoľné."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "To raske spørsmål mens du husker det. Begge er valgfrie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Două întrebări scurte despre ce tocmai s-a întâmplat. Ambele sunt opționale."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два короткі запитання про те, що щойно сталося. Обидва необов’язкові."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due domande veloci su ciò che è appena successo. Entrambe facoltative."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "趁现在记下两个简短问题的回答，都可以跳过。"
          }
        }
      }
    },
