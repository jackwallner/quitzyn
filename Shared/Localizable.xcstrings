    "Plans are temporarily unavailable. Please try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans are temporarily unavailable. Please try again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pläne sind gerade nicht verfügbar. Bitte versuch es gleich noch einmal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарифы временно недоступны. Попробуйте чуть позже."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabídky jsou dočasně nedostupné. Zkuste to za chvíli znovu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnemangen är tillfälligt otillgängliga. Försök igen om en stund."
