    "Two quick questions while it's fresh. Both optional.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two quick questions while it's fresh. Both optional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei kurze Fragen, solange es frisch ist. Beide freiwillig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два коротких вопроса, пока свежо в памяти. Оба необязательны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvě rychlé otázky, dokud je to čerstvé. Obě nepovinné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två snabba frågor medan det är färskt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi nopeaa kysymystä, kun se on tuoreessa muistissa. Molemmat vapaaehtoisia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee snelle vragen nu het nog vers is. Allebei optioneel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos preguntas rápidas mientras está reciente. Ambas opcionales."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To hurtige spørgsmål, mens den er frisk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa szybkie pytania, póki pamiętasz. Oba opcjonalne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dve rýchle otázky, kým sú čerstvé."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "To raske spørsmål mens det er ferskt. Begge valgfrie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Două întrebări rapide cât e proaspătă."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два коротких питання, поки свіже в пам’яті. Обидва необов’язкові."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due domande veloci finché è fresco. Entrambe facoltative."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个快速的问题同时是新鲜的 两个都可以选择的"
          }
        }
      }
    },
