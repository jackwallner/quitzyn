    "Name a situation where I used to reach for a pouch. How did I navigate it?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a situation where I used to reach for a pouch. How did I navigate it?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk an eine Situation, in der du früher zu einem Nikotinbeutel gegriffen hättest. Wie bist du damit umgegangen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назовите ситуацию, когда я тянулся за сумкой."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jmenuj situaci, kdy jsem sahal po pytli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnge en situation där jag brukade nå för en påse. Hur navigerade jag den?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro tilanne, josta hain pussia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem een situatie waarin ik een zakje zocht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra una situación donde solía llegar a una bolsa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan navigerede jeg den?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymień sytuację, w której sięgałem po torbę."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymenuj situáciu, v ktorej som sa zvykol naťahovať o vrecko."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevn en situasjon der jeg pleide å nå etter en pose. Hvordan navigerte jeg det?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune-mi o situaţie în care obişnuiam să caut o geantă."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва ситуації, де я використовував для досягнення підсумка. Як я навігував його?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Definire una situazione in cui ho usato per raggiungere una busta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说说以前我找过邮袋的情况 我怎么找到的?"
          }
        }
      }
    },
