    "Your tree joins the grove. A new sapling begins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tree joins the grove. A new sapling begins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Baum zieht in den Hain. Ein neuer Setzling wächst heran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше дерево стало частью рощи. Рядом начинает расти новый саженец."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš strom se přidává do háje. Začíná růst nová sazenice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt träd får en plats i lunden. En ny planta börjar växa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puusi liittyy lehtoon. Uusi taimi alkaa kasvaa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je boom krijgt een plek in het bosje. Er begint een nieuwe jonge boom te groeien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu árbol se une a la arboleda. Empieza a crecer un nuevo brote."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit træ bliver en del af lunden. En ny spire begynder at vokse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje drzewko trafia do gaju. Zaczyna rosnąć nowa sadzonka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj stromček sa pridáva do hája. Začína rásť nová sadenica."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Treet ditt blir en del av lunden. En ny småplante begynner å vokse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copacul dvs. se alătură grădinii. Un puiet nou începe să crească."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше дерево приєднується до гаю. Поруч росте новий саджанець."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo albero si unisce al boschetto. Una nuova piantina inizia a crescere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的树将加入树林，一株新树苗开始生长。"
          }
        }
      }
    },
