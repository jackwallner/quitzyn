    "See when your %@ hit, what sets them off, and how long yours actually last, plus the rest of Bloom+.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See when your %@ hit, what sets them off, and how long yours actually last, plus the rest of Bloom+."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wann deine %1$@ auftreten, was sie auslöst und wie lange sie wirklich dauern, dazu alle weiteren Bloom+-Funktionen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, когда появляется ощущение %1$@, что его вызывает и как долго оно длится. В Bloom+ доступны и другие функции."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjistěte, kdy se vaše %1$@ objevují, co je spouští a jak dlouho trvají. Získáte i další funkce Bloom+."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se när dina %1$@ kommer, vad som utlöser dem och hur länge de varar, plus allt annat i Bloom+."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso, milloin %1$@ iskevät, mikä ne laukaisee ja kuinka kauan ne kestävät, sekä kaikki muu Bloom+."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wanneer je %1$@ opkomen, wat ze uitlokt en hoe lang ze duren, plus de rest van Bloom+."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cuándo aparecen tus %1$@, qué las provoca y cuánto duran, además del resto de Bloom+."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvornår din %1$@ opstår, hvad der udløser den, og hvor længe den varer, plus resten af Bloom+."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, kiedy pojawiają się u ciebie %1$@, co je wywołuje i jak długo trwają, a także poznaj resztę Bloom+."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zisti, kedy sa objavujú tvoje %1$@, čo ich spúšťa a ako dlho trvajú, a získaj aj ďalšie funkcie Bloom+."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se når du får %1$@, hva som utløser det og hvor lenge det varer, pluss resten av Bloom+."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedeți când apar %1$@, ce le declanșează și cât durează în cazul dvs., plus restul Bloom+."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнайтеся, коли виникають %1$@, що їх провокує та скільки вони тривають. Також доступні інші можливості Bloom+."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri i momenti delle %1$@, cosa le scatena e quanto durano, insieme al resto di Bloom+."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解你的%1$@何时出现、由什么引发、通常持续多久，以及 Bloom+ 的其他功能。"
          }
        }
      }
    },
