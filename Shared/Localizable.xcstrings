        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас платить не нужно · Apple напомнит перед списанием · Данные хранятся на устройстве"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď neplatíte · Apple vás před platbou upozorní · Data zůstávají v zařízení"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen betalning nu · Apple påminner före debitering · Data finns kvar på enheten"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei maksua nyt · Apple muistuttaa ennen veloitusta · Tiedot pysyvät laitteella"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu geen betaling · Apple herinnert je vóór de afschrijving · Gegevens blijven op dit apparaat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin pago ahora · Apple te avisa antes del cobro · Los datos se quedan en el dispositivo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen betaling nu · Apple minder dig om det før opkrævning · Data bliver på enheden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz bez opłat · Apple przypomni przed naliczeniem opłaty · Dane zostają na tym urządzeniu"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz neplatíš · Apple ťa upozorní pred platbou · Dáta zostávajú v zariadení"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
