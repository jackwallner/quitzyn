    "Plans are temporarily unavailable. Please try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans are temporarily unavailable. Please try again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pläne sind gerade nicht verfügbar. Bitte versuch es gleich noch einmal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарифы временно недоступны. Попробуйте чуть позже."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plány jsou dočasně nedostupné. Zkus to prosím za chvíli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planer är tillfälligt otillgängliga. Försök igen på ett ögonblick."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukset eivät ole hetkeen saatavilla. Yritä hetken päästä uudelleen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen zijn tijdelijk niet beschikbaar. Probeer het zo opnieuw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los planes no están disponibles por ahora. Inténtalo de nuevo en un momento."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planer er midlertidigt utilgængelige. Prøv igen om et øjeblik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plany są chwilowo niedostępne. Spróbuj ponownie za chwilę."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plány sú dočasne nedostupné. Prosím, skúste to znova v okamihu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementene er midlertidig utilgjengelige. Prøv igjen om litt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planurile sunt temporar indisponibile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарифи тимчасово недоступні. Спробуйте трохи згодом."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I piani non sono al momento disponibili. Riprova tra poco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有计划 请稍候再试一次"
          }
        }
      }
    },
    "Plus %@ pouches you won't put in. That's the nicotine your body never has to process.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus %@ pouches you won't put in. That's the nicotine your body never has to process."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzlich %1$@ Nikotinbeutel, die du nicht nutzt. So viel Nikotin muss dein Körper nicht verarbeiten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё %1$@ никотиновых пакетиков, которые ты не использовал. Твоему организму не придётся перерабатывать этот никотин."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navíc %1$@ nikotinových sáčků, které nepoužiješ. Tvoje tělo tak nemusí zpracovat tento nikotin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessutom %1$@ portioner snus som du inte använder. Då slipper kroppen ta hand om den nikotinen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisäksi %1$@ nikotiinipussia jää käyttämättä. Kehosi ei siis tarvitse käsitellä niiden nikotiinia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gebruikt bovendien %1$@ nicotinezakjes niet. Je lichaam hoeft die nicotine dus niet te verwerken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Además, no usarás %1$@ bolsitas de nicotina. Tu cuerpo no tendrá que procesar esa nicotina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Derudover bruger du %1$@ nikotinposer mindre. Så skal kroppen ikke behandle den nikotin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowo nie użyjesz %1$@ saszetek nikotynowych. Organizm nie będzie musiał przetwarzać tej nikotyny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Navyše nepoužiješ %1$@ nikotínových vrecúšok. Tvoje telo tak nemusí spracovať tento nikotín."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I tillegg bruker du ikke %1$@ nikotinposer. Kroppen slipper dermed å behandle den nikotinen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În plus, nu vei folosi %1$@ pliculețe cu nicotină. Corpul tău nu va trebui să proceseze acea nicotină."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще %1$@ нікотинових пакетиків ти не використаєш. Організму не доведеться переробляти цей нікотин."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In più, non userai %1$@ bustine di nicotina. Il tuo corpo non dovrà elaborare quella nicotina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另外，你会少用%1$@袋尼古丁，身体也就不必处理这些尼古丁。"
          }
        }
      }
    },
