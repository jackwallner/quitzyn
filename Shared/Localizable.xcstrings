    "Renews automatically. Cancel at least 24 hours before the current period ends. Manage in Settings › Apple ID › Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically. Cancel at least 24 hours before the current period ends. Manage in Settings › Apple ID › Subscriptions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch. Kündige mindestens 24 Stunden vor Periodenende. Verwalten: Einstellungen › Apple-ID › Abonnements."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка продлевается автоматически. Отмените её минимум за 24 часа до конца текущего периода. Управляйте подпиской: Настройки › Apple ID › Подписки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné se obnovuje automaticky. Zrušte ho alespoň 24 hodin před koncem aktuálního období. Spravujte ho v Nastavení › Apple ID › Předplatná."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas automatiskt. Säg upp minst 24 timmar före periodens slut. Hantera i Inställningar › Apple ID › Prenumerationer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu automaattisesti. Peru vähintään 24 tuntia ennen kauden loppua. Hallinta: Asetukset › Apple ID › Tilaukset."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt automatisch verlengd. Zeg minstens 24 uur vóór het einde van de huidige periode op. Beheer dit via Instellingen › Apple ID › Abonnementen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente. Cancela al menos 24 horas antes de que termine el periodo actual. Gestiona la suscripción en Ajustes › Apple ID › Suscripciones."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementet fornyes automatisk. Opsig mindst 24 timer før periodens udløb. Administrer det i Indstillinger › Apple ID › Abonnementer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja odnawia się automatycznie. Anuluj ją co najmniej 24 godziny przed końcem bieżącego okresu. Zarządzaj nią w: Ustawienia › Apple ID › Subskrypcje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predplatné sa obnovuje automaticky. Zruš ho aspoň 24 hodín pred koncom aktuálneho obdobia. Spravuje sa v Nastaveniach › Apple ID › Predplatné."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementet fornyes automatisk. Avslutt minst 24 timer før perioden utløper. Administrer i Innstillinger › Apple-ID › Abonnementer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reînnoiește automat. Puteți anula cu cel puțin 24 de ore înainte de încheierea perioadei curente. Gestionați abonamentul în Configurări › ID Apple › Abonamente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписка поновлюється автоматично. Скасуйте її щонайменше за 24 години до завершення поточного періоду. Керуйте підпискою в Параметрах › Apple ID › Підписки."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente. Annulla almeno 24 ore prima della fine del periodo in corso. Gestisci l’abbonamento in Impostazioni › ID Apple › Abbonamenti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅会自动续订。请至少在当前周期结束前 24 小时取消。前往“设置”› Apple ID ›“订阅”管理。"
          }
        }
      }
    },
