    "Either way is fine. You can revisit this any time in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either way is fine. You can revisit this any time in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beides ist in Ordnung. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете вернуться к этому в любое время в Настройках."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V každém případě je to v pořádku. Můžete si to kdykoliv v Nastavení zopakovat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda alternativen går bra. Du kan ändra dig när som helst i Inställningar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit palata tähän milloin tahansa Asetuksissa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide keuzes zijn prima. Je kunt dit op elk moment wijzigen in Instellingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera de las dos opciones está bien. Puedes cambiarla cuando quieras en Ajustes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge dele er helt fint. Du kan ændre det når som helst i Indstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba wybory są w porządku. Możesz zmienić zdanie w dowolnym momencie w Ustawieniach."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obe možnosti sú v poriadku. Kedykoľvek ich môžeš zmeniť v Nastaveniach."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge deler er helt greit. Du kan endre dette når som helst i Innstillinger."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricare variantă este în regulă. Puteți reveni oricând la această opțiune din Configurări."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидва варіанти підходять. Ви можете будь-коли змінити це в Параметрах."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va bene in entrambi i casi. Puoi cambiarlo quando vuoi in Impostazioni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "怎么选都可以。你随时可以在“设置”中更改。"
          }
        }
      }
    },
