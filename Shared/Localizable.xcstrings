            "state": "translated",
            "value": "Registra un ansia más para descubrir mejor tus patrones."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log endnu et tilfælde af nikotintrang for at se flere af dine mønstre."
