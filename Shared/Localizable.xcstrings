    "Cancel anytime before it ends. No surprise charges.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel anytime before it ends. No surprise charges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jederzeit vor Ablauf kündigen. Keine unerwarteten Kosten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмените подписку до окончания пробного периода. Неожиданных списаний не будет."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné můžete kdykoli před koncem zrušit. Žádné nečekané poplatky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan avsluta när du vill innan perioden är slut. Inga oväntade kostnader."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit peruuttaa milloin vain ennen kokeilun päättymistä. Ei yllätysmaksuja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt op elk moment opzeggen voordat het afloopt. Geen onverwachte kosten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cancelar cuando quieras antes de que termine. Sin cargos inesperados."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan opsige når som helst, før perioden slutter. Ingen uventede opkrævninger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz anulować w dowolnym momencie przed końcem okresu. Bez niespodziewanych opłat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predplatné môžeš kedykoľvek zrušiť pred jeho koncom. Žiadne nečakané poplatky."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan avslutte når som helst før perioden er over. Ingen uventede kostnader."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți anula oricând înainte de încheiere. Fără costuri neașteptate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасуйте будь-коли до завершення пробного періоду. Неочікуваних списань не буде."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi annullare quando vuoi prima della fine. Nessun addebito a sorpresa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用结束前可随时取消，不会有意外扣费。"
          }
        }
      }
    },
