    "A lacy maple in warm autumn red and gold. Star-shaped leaves drift down as the days add up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lacy maple in warm autumn red and gold. Star-shaped leaves drift down as the days add up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein filigraner Ahorn in warmem Herbstrot und Gold. Sternförmige Blätter fallen, während die Tage zunehmen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ажурный клён в тёплых осенних оттенках красного и золотого. По мере того как дни складываются в серию, с дерева опадают листья в форме звёзд."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemně tvarovaný javor v teplých podzimních odstínech červené a zlaté. Jak přibývají dny, opadávají jeho hvězdicovité listy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En flikig lönn i höstens varma röda och gyllene färger. Stjärnformade löv singlar ner medan dagarna blir fler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitsilehtinen vaahtera hehkuu lämpimissä syyspunaisen ja kullan sävyissä. Tähtimäiset lehdet leijailevat päivien karttuessa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een fijnbladige esdoorn in warme herfstkleuren. Stervormige bladeren dwarrelen neer terwijl de dagen optellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arce de hojas finas, teñidas de rojo y dorado otoñales. Las hojas en forma de estrella caen mientras se acumulan los días."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En fintandet ahorn i varme efterårsfarver. Stjerneformede blade daler, mens dagene tæller op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatny klon w ciepłych odcieniach jesiennej czerwieni i złota. Liście w kształcie gwiazdek opadają, gdy rośnie twoja seria."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemný javor v teplých jesenných odtieňoch červenej a zlatej. Keď pribúdajú dni, opadávajú jeho hviezdicové listy."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lett og elegant lønn i varme høstfarger, rødt og gull. Stjerneformede blader daler etter hvert som dagene går."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arțar cu frunziș delicat, în nuanțe calde de roșu și auriu. Frunzele în formă de stea cad pe măsură ce se adună zilele."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клен із мереживним листям у теплих осінніх червоних і золотих барвах. Листя у формі зірок опадає, поки додаються дні."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acero dal fogliame delicato, nei caldi toni autunnali del rosso e dell’oro. Le foglie a stella cadono man mano che i giorni si sommano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "枫树枝叶细密，秋色金红。星形叶片随着日子累积缓缓飘落。"
          }
        }
      }
    },
