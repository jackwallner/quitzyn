            "value": "Registrera ett sug till för att upptäcka fler av dina mönster."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa vielä yksi nikotiininhimo, niin näet omat kuviosi paremmin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer nog één nicotinetrek om meer patronen te ontdekken."
          }
        },
