            "value": "Apple vil vise fakturering detaljer, før du bekræfter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple pokaże szczegóły rozliczeń przed potwierdzeniem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple pred potvrdením ukáže fakturačné údaje."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple vil vise faktureringsdetaljene før du bekrefter."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple va arăta detaliile de facturare înainte de a confirma."
          }
        },
        "uk": {
          "stringUnit": {
