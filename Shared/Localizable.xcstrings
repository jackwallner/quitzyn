    "Every time you ride out an urge, this page learns when they hit, what sets them off, and how long they last.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every time you ride out an urge, this page learns when they hit, what sets them off, and how long they last."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit jedem Verlangen, das du überstehst, zeigt dir diese Seite, wann es auftritt, wodurch es ausgelöst wird und wie lange es anhält."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раз, когда вы пережидаете тягу, эта страница показывает, когда она возникает, что её вызывает и как долго длится."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdykoli zvládnete nutkání, tato stránka ukáže, kdy přichází, co ho spouští a jak dlouho trvá."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje gång du står emot nikotinsuget lär sig sidan när det kommer, vad som utlöser det och hur länge det varar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisesta selättämästäsi nikotiininhimosta sivulle kertyy tietoa siitä, milloin ne iskevät, mikä niitä laukaisee ja kuinka kauan ne kestävät."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke keer dat je nicotinetrek doorstaat, verzamelt deze pagina gegevens over wanneer die opkomt, wat die uitlokt en hoe lang die duurt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que superas las ansias de nicotina, esta página registra cuándo aparecen, qué las provoca y cuánto duran."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gang du kommer igennem nikotintrangen, lærer siden, hvornår den opstår, hvad der udløser den, og hvor længe den varer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za każdym razem, gdy przeczekujesz głód nikotynowy, ta strona zapamiętuje, kiedy się pojawia, co go wywołuje i jak długo trwa."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakaždým, keď zvládneš chuť na nikotín, táto stránka si zapamätá, kedy prichádza, čo ju spúšťa a ako dlho trvá."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gang du kommer deg gjennom et nikotinsug, lærer denne siden når det kommer, hva som utløser det og hvor lenge det varer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De fiecare dată când treceți cu bine peste o poftă de nicotină, această pagină înregistrează când apare, ce o declanșează și cât durează."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоразу, коли вам вдається перечекати потяг, ця сторінка фіксує, коли він виникає, що його провокує і скільки він триває."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni volta che superi una voglia, questa pagina registra quando arriva, cosa la scatena e quanto dura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次你挺过渴求，这里都会记录它何时出现、由什么引发，以及持续多久。"
          }
        }
      }
    },
    "Every tool that keeps the streak visible, unlocked today.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every tool that keeps the streak visible, unlocked today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Werkzeug, das deine Serie sichtbar hält, heute freigeschaltet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня вам доступны все инструменты, которые помогают следить за серией."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes získáte přístup ke všem nástrojům, které zobrazují vaši sérii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp alla verktyg som visar din svit redan i dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa jo tänään kaikki työkalut, joiden avulla näet päiväputkesi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel vandaag alle tools die je reeks zichtbaar houden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea hoy todas las herramientas que mantienen visible tu racha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås i dag op for alle værktøjer, der holder din serie synlig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już dziś odblokuj wszystkie narzędzia do śledzenia swojej serii."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odomkni si už dnes všetky nástroje na sledovanie svojej série."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp alle verktøyene som viser rekken din, allerede i dag."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Astăzi ați deblocat toate instrumentele care vă ajută să vă urmăriți seria."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні розблоковано всі інструменти, що допомагають стежити за серією."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi hai sbloccato tutti gli strumenti che tengono in vista la tua serie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有帮助你查看连续天数的工具，今天都已解锁。"
          }
        }
      }
    },
