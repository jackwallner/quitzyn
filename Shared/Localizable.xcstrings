    "A flowering sakura wrapped in soft pink bloom. Petals drift down as your streak grows.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A flowering sakura wrapped in soft pink bloom. Petals drift down as your streak grows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine blühende Sakura in zartem Rosa. Blütenblätter fallen, während deine Serie wächst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цветущая сакура в нежно-розовом цвету. Лепестки опадают по мере роста серии."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvetoucí sakura v jemně růžových odstínech. Jak vaše série roste, okvětní lístky pomalu opadávají."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En blommande sakura med mjukt rosa blommor. Kronblad singlar ner medan din svit växer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pehmeän vaaleanpunaisin kukin kukkiva sakura. Terälehtiä leijailee, kun päiväputkesi kasvaa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bloeiende sakura met zachtroze bloemen. Bloemblaadjes dwarrelen neer terwijl je reeks groeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sakura cubierto de flores rosas. Los pétalos caen mientras crece tu racha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En blomstrende sakura med bløde, lyserøde blomster. Kronblade daler, mens din serie vokser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwitnąca sakura w delikatnym różu. Płatki opadają, gdy rośnie twoja seria."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozkvitnutá sakura s jemne ružovými kvetmi. S rastom tvojej série opadávajú lupienky."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En blomstrende sakura med mykrosa blomster. Kronbladene daler mens rekken din vokser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sakura înflorit, cu petale roz delicate. Pe măsură ce vă crește seria, petalele plutesc ușor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Квітуча сакура в ніжно-рожевих квітах. Пелюстки поволі опадають, а ваша серія зростає."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sakura in fiore, avvolto da una delicata tonalità rosa. I petali cadono mentre la tua serie cresce."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "樱花盛开，花色柔粉。随着连续天数增加，花瓣缓缓飘落。"
          }
        }
      }
    },
