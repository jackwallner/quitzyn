    "Either way is fine. You can revisit this any time in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either way is fine. You can revisit this any time in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beides ist in Ordnung. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете вернуться к этому в любое время в Настройках."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V každém případě je to v pořádku. Můžete si to kdykoliv v Nastavení zopakovat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur som helst är bra. Du kan se över detta när som helst i Inställningar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit palata tähän milloin tahansa Asetuksissa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe dan ook is prima. U kunt dit opnieuw bekijken op elk moment in Instellingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De cualquier manera está bien, puedes revisitarlo en cualquier momento en Ajustes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gense dette når som helst i Indstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak czy inaczej, możesz to ponownie sprawdzić w Ustawieniach."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete to kedykoľvek zopakovať v Nastaveniach."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uansett er det bra. Du kan se dette når som helst i Innstillinger."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poţi să revezi asta oricând în Setări."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В будь-який час можна переглянути в налаштуваннях."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In entrambi i casi va bene, puoi rivisitarlo in qualsiasi momento in Impostazioni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论哪种方式都是好的。 您可以在设置中随时重温 。"
          }
        }
      }
    },
