    "Write through the cravings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write through the cravings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib auf, was du während des Verlangens erlebst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите, что вы чувствуете во время тяги."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište si, co prožíváte při nutkání."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv ner hur suget känns."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita nikotiininhimostasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf over je nicotinetrek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe sobre las ansias cuando aparezcan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dig gennem nikotintrangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz swoje odczucia, gdy pojawia się głód nikotynowy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíš si, čo prežívaš, keď príde chuť na nikotín."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv om hvordan nikotinsuget føles."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrieți despre poftele de nicotină."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте думки, коли виникає потяг."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi cosa provi quando arriva la voglia."
          }
        },
        "zh-Hans": {
