    "Used to estimate the money, pouches, and nicotine you avoid while you stay nicotine-free.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dient dazu, Geld, Nikotinbeutel und Nikotin zu schätzen, die du während deiner nikotinfreien Zeit einsparst oder nicht konsumierst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти данные помогают оценить, сколько денег, никотиновых паучей и никотина вы не расходуете, оставаясь без никотина."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slouží k odhadu, kolik peněz a nikotinových sáčků ušetříš a kolika dávkám nikotinu se vyhneš, když žiješ bez nikotinu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används för att uppskatta hur mycket pengar och portionssnus du sparar och hur mycket nikotin du avstår från när du är nikotinfri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näitä tietoja käytetään arvioimaan, kuinka paljon rahaa ja nikotiinipusseja säästyy ja kuinka paljon nikotiinia jää käyttämättä nikotiinittomana aikana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gegevens schatten hoeveel geld en nicotinezakjes je bespaart en hoeveel nicotine je vermijdt zolang je nicotinevrij blijft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirve para calcular cuánto dinero y cuántas bolsitas ahorras, y cuánta nicotina evitas mientras sigues sin consumirla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges til at anslå, hvor mange penge og nikotinposer du sparer, og hvor meget nikotin du undgår, mens du er nikotinfri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Służy do oszacowania, ile pieniędzy i saszetek nikotynowych oszczędzasz oraz ile nikotyny omijasz, pozostając bez nikotyny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slúži na odhad, koľko peňazí a nikotínových vrecúšok ušetríš a koľkému nikotínu sa vyhneš, keď zostaneš bez nikotínu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukes til å anslå hvor mye penger og hvor mange nikotinposer du sparer, og hvor mye nikotin du unngår når du er nikotinfri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajută la estimarea banilor și a pliculețelor cu nicotină pe care le economisești, precum și a nicotinei pe care o eviți cât timp nu consumi nicotină."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допомагає оцінити, скільки грошей і нікотинових пакетиків ви заощаджуєте та скільки нікотину уникаєте, залишаючись без нього."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve a stimare quanto denaro e quante bustine risparmi e quanta nicotina eviti mentre resti senza nicotina."
