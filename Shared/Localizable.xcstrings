    "Every craving you rode out ended without a pouch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every craving you rode out ended without a pouch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Verlangen, das du überstanden hast, endete ohne Nikotinbeutel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раз, когда вы справлялись с тягой, вы обходились без никотинового пауча."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé nutkání, které jste zvládli, skončilo bez nikotinového sáčku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje sug du tog dig igenom tog slut utan en nikotinpåse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen selättämäsi nikotiininhimo päättyi ilman nikotiinipussia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke nicotinetrek die je doorstaat, eindigt zonder nicotinezakje."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada episodio de ansias de nicotina que superaste terminó sin usar una bolsita."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gang du kom igennem nikotintrangen, endte det uden en nikotinpose."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy przeczekany epizod głodu nikotynowego minął bez sięgania po saszetkę."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá prečkaná epizóda chuti na nikotín sa skončila bez nikotínového vrecúška."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert nikotinsug du kom deg gjennom, endte uten en nikotinpose."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare poftă de nicotină căreia i-ați făcut față s-a încheiat fără un pliculeț."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після кожного подоланого потягу ви обходилися без нікотинового пакетика."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni voglia di nicotina che hai superato è passata senza usare una bustina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次挺过渴求，都没有使用尼古丁袋。"
          }
        }
      }
    },
    "Every dollar and pouch you avoid, tracked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every dollar and pouch you avoid, tracked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder gesparte Euro und jeder vermiedene Nikotinbeutel wird erfasst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте сэкономленные деньги и неиспользованные никотиновые паучи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte ušetřené peníze a nepoužité nikotinové sáčky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll koll på varje krona och varje nikotinpåse du slipper köpa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa säästämiäsi dollareita ja käyttämättä jääviä nikotiinipusseja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd bij hoeveel geld en hoeveel nicotinezakjes je bespaart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva la cuenta del dinero que ahorras y de las bolsitas de nicotina que evitas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold styr på de penge og nikotinposer, du sparer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź zaoszczędzone pieniądze i niewykorzystane saszetki nikotynowe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj ušetrené peniaze aj nespotrebované nikotínové vrecúška."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg med på pengene du sparer og nikotinposene du unngår."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărim fiecare dolar și fiecare pliculeț cu nicotină pe care îl evitați."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте кожен долар і кожен нікотиновий пакетик, яких вам вдалося уникнути."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Teniamo traccia di ogni dollaro e bustina di nicotina che eviti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一笔省下的钱、每一袋少用的尼古丁袋，都帮你记录下来。"
          }
        }
      }
    },
    "Every nicotine-free day grows your tree.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
