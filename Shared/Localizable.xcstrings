    "Based on sessions you rode out, not an average across everyone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on sessions you rode out, not an average across everyone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beruht auf den Verlangen, die du überstanden hast, nicht auf einem Durchschnitt aller."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расчёт основан на пережитых тобой эпизодах, а не на среднем показателе всех пользователей."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vychází z nutkání, která máš zaznamenaná jako překonaná, ne z průměru všech."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygger på de sug du tog dig igenom, inte på ett genomsnitt för alla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perustuu läpikäymiisi mielitekoihin, ei kaikkien keskiarvoon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaseerd op de drangmomenten die je hebt doorstaan, niet op een gemiddelde van iedereen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se basa en los deseos que superaste, no en el promedio de todas las personas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygger på de trangoplevelser, du kom igennem, ikke på et gennemsnit af alle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie odpartych przez ciebie silnych chęci, nie średniej dla wszystkich."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vychádza zo zaznamenaných zvládnutých nutkaní, nie z priemeru všetkých."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygger på sug du kom deg gjennom, ikke et gjennomsnitt for alle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se bazează pe poftele peste care ai trecut, nu pe media tuturor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На основі потягів, які тобі вдалося пережити, а не середнього показника всіх."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si basa sugli impulsi che hai superato, non su una media generale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于你挺过的冲动记录，而非所有人的平均值。"
          }
        }
      }
    },
