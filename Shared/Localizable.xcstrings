            "state": "translated",
            "value": "Esto ocurrió %1$lld veces entre tus últimos %2$lld registros."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det skete %1$lld gange blandt dine seneste %2$lld registreringer."
          }
        },
