    "Shaped by a lifetime of wind. Every branch tells a story of endurance.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaped by a lifetime of wind. Every branch tells a story of endurance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geformt von einem Leben voller Wind. Jeder Ast erzählt von Ausdauer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сформирован ветрами за всю жизнь. Каждая ветвь рассказывает о стойкости."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Utvářená celoživotním větrem. Každá větev vypráví příběh vytrvalosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Formad av en livstid av vind. Varje gren berättar en historia om uthållighet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Elinikäisen tuulen muovaama. Jokainen oksa kertoo sitkeydestä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gevormd door een leven lang wind. Elke tak vertelt een verhaal van volharding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moldeado por toda una vida de viento. Cada rama cuenta una historia de resistencia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle grene fortæller om udholdenhed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiatr przez lata nadawał mu kształt. Każda gałąź świadczy o jego wytrwałości."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietor ho formoval celé roky. Každá vetva rozpráva príbeh vytrvalosti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Formet av år med vind. Hver grein forteller en historie om utholdenhet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelat de vânt de-a lungul anilor. Fiecare ramură spune o poveste despre rezistență."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сформований вітрами за багато років. Кожна гілка розповідає історію витривалості."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scolpito dal vento nel corso degli anni. Ogni ramo racconta una storia di resistenza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经年风吹塑出独特树形，每根枝条都诉说着坚韧。"
          }
        }
      }
    },
