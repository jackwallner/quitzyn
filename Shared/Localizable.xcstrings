    "Cancel anytime before it ends. No surprise charges.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel anytime before it ends. No surprise charges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jederzeit vor Ablauf kündigen. Keine unerwarteten Kosten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмените подписку до окончания пробного периода. Неожиданных списаний не будет."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zruš kdykoli před koncem. Žádné překvapivé platby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan avsluta när du vill innan perioden är slut. Inga oväntade kostnader."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit peruuttaa milloin vain ennen kokeilun päättymistä. Ei yllätysmaksuja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt op elk moment opzeggen. Geen onverwachte kosten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cancelar cuando quieras antes de que termine. Sin cargos inesperados."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan opsige når som helst, inden perioden slutter. Ingen uventede opkrævninger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz anulować w dowolnym momencie przed końcem okresu. Bez niespodziewanych opłat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžeš zrušiť kedykoľvek pred koncom. Bez nečakaných platieb."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan avslutte når du vil før prøveperioden er over. Ingen uventede kostnader."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți anula oricând înainte să se încheie. Fără costuri neașteptate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасуйте до кінця пробного періоду. Несподіваних списань не буде."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi annullare quando vuoi prima della fine. Nessun addebito a sorpresa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用期结束前可随时取消，不会产生意外扣费。"
          }
        }
      }
    },
    "Cardiovascular strain eases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
