    "How has my daily life changed since I quit nicotine?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How has my daily life changed since I quit nicotine?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie hat sich mein tägliches Leben verändert, seit ich mit Nikotin aufgehört habe?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как изменилась моя жизнь после отказа от никотина?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co se změnilo v mém každodenním životě od chvíle, kdy žiju bez nikotinu?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur har mitt dagliga liv förändrats sedan jag slutade med nikotin?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miten päivittäinen elämäni on muuttunut sen jälkeen, kun lopetin nikotiinin käytön?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe is mijn dagelijks leven veranderd sinds ik met nicotine stopte?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo ha cambiado mi vida cotidiana desde que dejé la nicotina?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan har mit daglige liv ændret sig, siden jeg stoppede med nikotin?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak zmieniła się moja codzienność po odstawieniu nikotyny?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako sa zmenil môj každodenný život po vysadení nikotínu?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan har hverdagen endret seg etter at jeg sluttet med nikotin?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum s-a schimbat viața mea de zi cu zi de când am renunțat la nicotină?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як змінилося моє повсякденне життя після відмови від нікотину?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Com’è cambiata la mia vita quotidiana da quando ho smesso con la nicotina?"
