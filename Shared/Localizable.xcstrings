    "Renews automatically. Cancel at least 24 hours before the current period ends. Manage in Settings › Apple ID › Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically. Cancel at least 24 hours before the current period ends. Manage in Settings › Apple ID › Subscriptions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch. Kündige mindestens 24 Stunden vor Periodenende. Verwalten: Einstellungen › Apple-ID › Abonnements."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевается автоматически. Отмени минимум за 24 часа до конца периода. Управление: Настройки › Apple ID › Подписки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky se obnoví. Zruš nejpozději 24 hodin před koncem období. Správa: Nastavení › Apple ID › Předplatná."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas automatiskt. Avsluta minst 24 timmar före periodens slut. Hantera: Inställningar › Apple-ID › Abonnemang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu automaattisesti. Peru vähintään 24 tuntia ennen kauden loppua. Hallinta: Asetukset › Apple ID › Tilaukset."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt automatisch verlengd. Zeg minstens 24 uur voor het einde op. Beheer: Instellingen › Apple ID › Abonnementen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente. Cancela al menos 24 horas antes del fin del periodo. Gestiona en Ajustes › Apple ID › Suscripciones."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk. Opsig mindst 24 timer før periodens slutning. Administrer: Indstillinger › Apple-id › Abonnementer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odnawia się automatycznie. Anuluj co najmniej 24 godziny przed końcem okresu. Zarządzaj: Ustawienia › Apple ID › Subskrypcje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje sa automaticky. Zruš aspoň 24 hodín pred koncom obdobia. Správa: Nastavenia › Apple ID › Predplatné."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk. Si opp minst 24 timer før perioden slutter. Administrer: Innstillinger › Apple-ID › Abonnementer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reînnoiește automat. Anulează cu cel puțin 24 de ore înainte de finalul perioadei. Gestionează: Configurări › Apple ID › Abonamente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поновлюється автоматично. Скасуйте за 24 години до кінця періоду. Керування: Параметри › Apple ID › Підписки."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente. Annulla almeno 24 ore prima della fine del periodo. Gestisci: Impostazioni › ID Apple › Abbonamenti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅会自动续订。请至少在当前周期结束前 24 小时取消。前往“设置”› Apple ID ›“订阅”管理。"
          }
        }
      }
    },
