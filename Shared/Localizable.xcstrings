    "What did I do today that my future self will thank me for?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What did I do today that my future self will thank me for?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was habe ich heute getan, wofür mir mein zukünftiges Ich danken wird?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что я сделал сегодня, за что меня поблагодарит я из будущего?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jsem dnes udělal, za co mi budoucí já poděkuje?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad gjorde jag idag för att mitt framtida jag ska tacka mig för?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä tein tänään, mistä tuleva minäni kiittää?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat deed ik vandaag waar mijn toekomstige ik me dankbaar voor is?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué hice hoy que mi yo del futuro me agradecerá?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad har jeg gjort i dag, som mit fremtidige jeg vil takke mig for?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co dziś zrobiłem, za co podziękuje mi moje przyszłe ja?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo som dnes urobil, že mi moje budúce ja poďakuje?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva gjorde jeg i dag som mitt fremtidige jeg vil takke meg for?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru ce am făcut azi că viitorul meu eu îmi va mulţumi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що я зробив сьогодні, за що мені подякує я з майбутнього?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ho fatto oggi per cui il me del futuro mi ringrazierà?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我今天做了什么,我的未来会感谢我?"
          }
        }
      }
    },
