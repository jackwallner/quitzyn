    "Puts your counter and your tree back the way they were before this slip.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts your counter and your tree back the way they were before this slip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt Zähler und Baum auf den Stand vor diesem Ausrutscher zurück."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернёт счётчик и дерево к состоянию до этого срыва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátí počítadlo i strom do stavu před tímto uklouznutím."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställer räknaren och trädet till läget före snedsteget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauttaa laskurin ja puun tilaan, jossa ne olivat ennen retkahdusta."
