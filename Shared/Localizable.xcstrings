    "Track every dollar and pouch you avoid, plus the rest of Bloom+.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track every dollar and pouch you avoid, plus the rest of Bloom+."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge jeden gesparten Euro und jeden vermiedenen Nikotinbeutel, plus die weiteren Bloom+ Funktionen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте каждый доллар и мешок, которые вы избегаете, плюс остальная часть Bloom+."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte každý dolar a váček, kterému se vyhnete, plus zbytek Bloom+."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spåra varje dollar och påse du undviker, plus resten av Bloom+."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa jokaista dollaria ja pussia, jota vältät, sekä Bloom+."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg elke dollar en zak die je vermijdt, plus de rest van Bloom+."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastrea cada dólar y bolsa que evite, más el resto de Bloom+."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor hver dollar og pose du undgår, plus resten af Bloom+."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź każdego dolara i torebki można uniknąć, plus reszta Bloom+."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte každý dolár a vrecko, ktorým sa vyhýbate, plus zvyšok Bloom+."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor hver dollar og pose du unngår, pluss resten av Bloom+."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește banii și pliculețele cu nicotină pe care le eviți, plus restul Bloom+."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте заощаджені гроші та кількість паучів, від яких ви відмовилися. Інші функції Bloom+ теж доступні."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracciare ogni dollaro e la busta si evita, più il resto di Bloom+."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追踪你所避免的每一美元和邮袋,加上Bloom+的其余部分."
          }
        }
      }
    },
    "Track your nicotine-free days, grow your garden, watch your health return.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track your nicotine-free days, grow your garden, watch your health return."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge deine nikotinfreien Tage, lass deinen Garten wachsen und beobachte deine gesundheitliche Entwicklung."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте дни без никотина, выращивайте сад и следите за своим самочувствием."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj dny bez nikotinu, pěstuj zahradu a pozoruj, jak se ti vrací zdraví."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ dina nikotinfria dagar, odla din trädgård och följ hur hälsan återhämtar sig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa nikotiinittomia päiviäsi, kasvata puutarhaasi ja seuraa vointisi kohenemista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg je nicotinevrije dagen, laat je tuin groeien en volg je herstel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue tus días sin nicotina, cultiva tu jardín y observa cómo recuperas tu salud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg dine dage uden nikotin, dyrk din have, og se din sundhed vende tilbage."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź dni bez nikotyny, uprawiaj ogród i obserwuj, jak wraca ci zdrowie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte dni bez nikotínu, pestujte záhradu a všímajte si, ako sa vám darí."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg dagene uten nikotin, dyrk hagen din og se helsen komme tilbake."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește zilele fără nicotină, crește-ți grădina și observă-ți progresul."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте дні без нікотину, вирощуйте сад і спостерігайте за відновленням здоров’я."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui i tuoi giorni senza nicotina, coltiva il tuo giardino e osserva il ritorno del benessere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录无尼古丁的日子，培育花园，关注健康的恢复。"
          }
        }
      }
    },
