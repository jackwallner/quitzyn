    "Apple will show the billing details before you confirm.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple will show the billing details before you confirm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple zeigt dir die Abrechnungsdetails, bevor du bestätigst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple покажет детали выставления счетов, прежде чем вы подтвердите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple zobrazí fakturační údaje před potvrzením."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple visar faktureringsdetaljerna innan du bekräftar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple näyttää laskutustiedot ennen vahvistusta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple zal de factuurgegevens tonen voordat u het bevestigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple mostrará los detalles de facturación antes de confirmar."
          }
        },
        "da": {
          "stringUnit": {
