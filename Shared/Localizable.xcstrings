    "%@ costs about a day and a half's worth of nicotine pouches.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostet etwa so viel wie Nikotinbeutel für anderthalb Tage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ стоит примерно как никотиновые паучи на полтора дня."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stojí přibližně tolik co nikotinové sáčky na den a půl."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostar ungefär lika mycket som nikotinpåsar för en och en halv dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ maksaa suunnilleen puolentoista päivän nikotiinipussien hinnan verran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kost ongeveer evenveel als nicotinezakjes voor anderhalve dag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cuesta aproximadamente lo mismo que las bolsitas de nicotina de un día y medio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisen på %1$@ svarer til det, du ville bruge på nikotinposer i halvanden dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena %1$@ odpowiada mniej więcej wydatkom na saszetki nikotynowe przez półtora dnia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena %1$@ zodpovedá približne výdavkom na nikotínové vrecúška za deň a pol."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisen på %1$@ tilsvarer omtrent det du bruker på nikotinposer i halvannen dag."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ costă cât pliculețele cu nicotină pentru aproximativ o zi și jumătate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ коштує приблизно стільки ж, скільки нікотинові пакетики за півтори доби."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ costa più o meno quanto le bustine di nicotina per una giornata e mezza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@约相当于一天半的尼古丁袋费用。"
          }
        }
      }
    },
