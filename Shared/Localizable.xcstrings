          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verktøyene som holder rekken synlig, låst opp i dag."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare instrument care păstrează dunga vizibilă, deblocat astăzi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі інструменти, що тримають серію на виду, відкриті вже сьогодні."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli strumenti che tengono in vista la tua serie, sbloccati oggi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一个工具 保持记录可见, 今天解锁。"
          }
        }
      }
    },
