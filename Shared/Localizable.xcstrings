    "The cascade style mimics a tree growing on a cliff, plunging downward.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cascade style mimics a tree growing on a cliff, plunging downward."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kaskadenstil zeigt einen Baum, der an einer Klippe wächst und nach unten hängt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каскадный стиль напоминает дерево, растущее на обрыве и свисающее вниз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskádový styl připomíná strom rostoucí na útesu, jehož větve splývají dolů."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskadstilen liknar ett träd som växer på en klippkant och faller nedåt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskadityyli jäljittelee jyrkänteellä kasvavaa, alas syöksyvää puuta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De cascadestijl lijkt op een boom die op een klif groeit en omlaag hangt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estilo en cascada imita un árbol que crece en un acantilado y cae hacia abajo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskadestilen efterligner et træ, der vokser på en klippe og hænger nedad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Styl kaskadowy naśladuje drzewo rosnące na klifie, którego gałęzie opadają w dół."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskádový štýl pripomína strom, ktorý rastie na útese a jeho vetvy visia nadol."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskadestilen etterligner et tre som vokser på en klippe og henger nedover."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilul în cascadă imită un copac care crește pe o stâncă, cu ramurile atârnând în jos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Каскадний стиль нагадує дерево, що росте на скелі й опускає гілки донизу."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stile a cascata ricorda un albero che cresce su una scogliera, con i rami protesi verso il basso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬崖式造型模仿生长在峭壁上的树木，枝干向下延伸。"
          }
        }
      }
    },
    "The hardest stretch passes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
