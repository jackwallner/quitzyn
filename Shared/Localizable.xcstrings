    "Irritability and anxiety ease.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irritability and anxiety ease."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reizbarkeit und Angst lassen nach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздражительность и тревожность ослабевают."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrážděnost a úzkost polevují."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Irritabilitet och oro avtar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ärtyneisyys ja ahdistus hellittävät."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikkelbaarheid en angst nemen af."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disminuyen la irritabilidad y la ansiedad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Irritabilitet og uro aftager."
          }
        },
        "pl": {
