    "If today's nicotine-free, log it and water your garden.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If today's nicotine-free, log it and water your garden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du heute nikotinfrei bist, trag den Tag ein und gieße deinen Garten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сегодня вы не употребляли никотин, отметьте этот день и полейте сад."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud jste dnes bez nikotinu, zaznamenejte to a zalijte zahradu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du är nikotinfri i dag, registrera dagen och vattna trädgården."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos olet tänään nikotiiniton, tee päivämerkintä ja kastele puutarhasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je vandaag nicotinevrij bent, registreer de dag en geef je tuin water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hoy no consumes nicotina, registra el día y riega tu jardín."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du er uden nikotin i dag, så registrer dagen og vand haven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli dzisiejszy dzień jest bez nikotyny, dodaj wpis i podlej ogród."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je dnešok bez nikotínu, pridaj záznam a polej záhradu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har en dag uten nikotin, registrer den og vann hagen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă ați fost fără nicotină astăzi, înregistrați ziua și udați grădina."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо сьогодні ви не вживали нікотин, позначте цей день і полийте сад."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se oggi sei senza nicotina, registra la giornata e annaffia il giardino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果今天没有摄入尼古丁，就记录下来并给花园浇水。"
          }
        }
      }
    },
