    "Nicotine has a short half-life, so within several hours the level in your blood falls by more than half as your body clears the last dose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicotine has a short half-life, so within several hours the level in your blood falls by more than half as your body clears the last dose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotin hat eine kurze Halbwertszeit. Innerhalb weniger Stunden sinkt der Nikotinspiegel im Blut um mehr als die Hälfte, während dein Körper die letzte Dosis abbaut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У никотина короткий период полураспада, поэтому за несколько часов его уровень в крови снижается более чем наполовину, пока организм выводит последнюю дозу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotin má krátký poločas rozpadu, takže jeho hladina v krvi během několika hodin klesne o více než polovinu, zatímco tělo odbourává poslední dávku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotin har kort halveringstid. Inom några timmar sjunker halten i blodet med mer än hälften när kroppen gör sig av med den sista dosen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotiinin puoliintumisaika on lyhyt. Veren nikotiinipitoisuus laskee muutamassa tunnissa yli puoleen, kun elimistö poistaa viimeisen annoksen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicotine heeft een korte halfwaardetijd. Binnen enkele uren daalt het nicotinegehalte in je bloed met meer dan de helft terwijl je lichaam de laatste dosis afbreekt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nicotina tiene una vida media corta. En pocas horas, su nivel en sangre cae más de la mitad mientras el cuerpo elimina la última dosis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotin har en kort halveringstid. I løbet af få timer falder niveauet i blodet med mere end halvdelen, mens kroppen nedbryder den sidste dosis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotyna ma krótki okres półtrwania, więc w ciągu kilku godzin jej poziom we krwi spada o ponad połowę, gdy organizm usuwa ostatnią dawkę."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotín má krátky biologický polčas, takže jeho hladina v krvi klesne v priebehu niekoľkých hodín o viac než polovicu, keď telo spracuje poslednú dávku."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotin har kort halveringstid. I løpet av noen timer synker nivået i blodet med mer enn halvparten mens kroppen bryter ned den siste dosen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicotina are un timp de înjumătățire scurt, așa că în câteva ore nivelul ei din sânge scade cu mai mult de jumătate, pe măsură ce organismul elimină ultima doză."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нікотин має короткий період напіврозпаду, тож за кілька годин його рівень у крові падає більш ніж удвічі, поки організм виводить останню дозу."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nicotina ha una breve emivita: in poche ore il suo livello nel sangue scende di oltre la metà mentre il corpo elimina l’ultima dose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尼古丁在体内停留的时间较短。身体代谢最后一次摄入的尼古丁时，血液中的含量会在几小时内下降一半以上。"
          }
        }
      }
    },
