    "Every time you ride out an urge, this page learns when they hit, what sets them off, and how long they last.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every time you ride out an urge, this page learns when they hit, what sets them off, and how long they last."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal, wenn du einem Verlangen standhältst, lernt diese Seite, wann es auftritt, wodurch es ausgelöst wird und wie lange es anhält."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раз, когда вы пережидаете тягу, страница запоминает, когда она возникает, что её вызывает и сколько она длится."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdykoli odoláš nutkání, stránka zaznamená, kdy přichází, co ho spouští a jak dlouho trvá."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje gång du står emot nikotinsuget lär sig sidan när det kommer, vad som utlöser det och hur länge det varar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joka kerta kun kestät nikotiininhimon, sivu oppii, milloin se iskee, mikä laukaisee sen ja kuinka kauan se kestää."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke keer dat je de trek doorstaat, leert deze pagina wanneer die opkomt, waardoor die wordt veroorzaakt en hoe lang die duurt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que resistes las ganas, esta página aprende cuándo aparecen, qué las provoca y cuánto duran."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gang du modstår nikotintrangen, lærer siden, hvornår den opstår, hvad der udløser den, og hvor længe den varer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za każdym razem, gdy przeczekasz głód nikotynowy, strona zapamiętuje, kiedy się pojawia, co go wywołuje i jak długo trwa."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakaždým, keď prečkáš nutkanie, stránka zaznamená, kedy prichádza, čo ho spúšťa a ako dlho trvá."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gang du står imot nikotinsuget, lærer denne siden når det kommer, hva som utløser det og hvor lenge det varer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De fiecare dată când reziști poftei, pagina învață când apare, ce o declanșează și cât durează."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоразу, коли ви перечікуєте потяг, сторінка запам’ятовує, коли він виникає, що його провокує і скільки триває."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni volta che resisti alla voglia, questa pagina impara quando arriva, cosa la scatena e quanto dura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次你挺过一次渴求，这个页面就会记录它何时出现、由什么引发，以及持续多久。"
          }
        }
      }
    },
    "Every tool that keeps the streak visible, unlocked today.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every tool that keeps the streak visible, unlocked today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Werkzeug, das deine Serie sichtbar hält, heute freigeschaltet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все инструменты, которые держат серию на виду, открыты уже сегодня."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny nástroje, které drží sérii na očích, odemčené ještě dnes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje verktyg som håller sträckan synlig, upplåst idag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki työkalut, jotka pitävät putken näkyvissä, auki jo tänään."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke tool die je reeks zichtbaar houdt, vandaag ontgrendeld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las herramientas que mantienen tu racha a la vista, desbloqueadas hoy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert værktøj, der holder stimen synlig, ulåst i dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie narzędzia, które trzymają serię na widoku, odblokowane już dziś."
