          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále bez nikotínu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsatt nikotinfri"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă fără nicotină"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натюрморт без нікотин"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora senza nicotina"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还是没有尼古丁"
          }
        }
      }
    },
    "Streak counts your current run. Lifetime counts every nicotine-free day you've ever logged, so past progress isn't lost on a reset.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak counts your current run. Lifetime counts every nicotine-free day you've ever logged, so past progress isn't lost on a reset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Serie zeigt deinen aktuellen Lauf. Lebenszeit zählt alle nikotinfreien Tage, die du je eingetragen hast. So bleibt dein Fortschritt auch nach einem Neustart erhalten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрик отсчитывает ваш текущий пробег. Жизнь отсчитывает каждый свободный от никотина день, который вы когда-либо регистрировали, поэтому прошлый прогресс не теряется при сбросе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak počítá váš současný běh. Celoživotní počítá každý den bez nikotinu, který jste kdy zaznamenali, takže minulý pokrok není ztracen v resetu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak räknar din nuvarande körning. Livstid räknas varje nikotinfri dag du någonsin har loggat, så tidigare framsteg går inte förlorad på en återställning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Elämä laskee jokaisen nikotiinittoman päivän."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak telt je huidige run. Levensduur telt elke nicotinevrije dag die je ooit hebt gelogd, zodat vooruitgang in het verleden niet verloren gaat op een reset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak cuenta tu carrera actual. Lifetime cuenta cada día libre de nicotina que hayas registrado, así que el progreso pasado no se pierde en un reset."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak tæller din nuværende køre. Livstid tæller hver nikotinfri dag du nogensinde har logget, så tidligere fremskridt er ikke tabt på en nulstilling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas życia liczy każdy wolny od nikotyny dzień, który kiedykolwiek zalogowałeś, więc postęp przeszłości nie jest utracony na resecie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak počíta váš súčasný beh. Celoživotný čas počíta každý deň bez nikotínu, ktorý ste kedy zaznamenali, takže minulý pokrok nie je stratený na reset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak teller din nåværende kjøring. Livstid teller hver nikotinfri dag du noensinne har logget, så tidligere fremgang går ikke tapt på en tilbakestilling."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Viaţa contează fiecare zi fără nicotină pe care ai înregistrat-o, aşa că progresul trecut nu e pierdut pe o resetare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте свій поточний хід. Час життя рахує кожен день без нікотину, який ви коли-небудь записали, тому минулий хід не загублений на скидання."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di vita conta ogni giorno senza nicotina che hai mai registrato, quindi i progressi passati non vengono persi su un reset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak)计算了您目前的运行情况,终生计算了您记录过的每一个没有尼古丁的一天,所以过去的进展不会因为重置而丢失."
          }
        }
      }
    },
