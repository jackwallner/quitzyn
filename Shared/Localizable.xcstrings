            "value": "Ein Samen ist gesetzt. Jeder große Baum beginnt hier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семя посажено. Каждое большое дерево начинается здесь."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Semínko je zasazené. Každý velký strom začíná tady."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett frö planteras. Varje bra träd börjar här."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siemen on istutettu. Jokainen suuri puu alkaa tästä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een zaadje geplant. Elke grote boom begint hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semilla plantada. Todo gran árbol empieza aquí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et frø er plantet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasionko zasiane. Każde wielkie drzewo zaczyna się tutaj."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý veľký strom začína tu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et frø er sådd. Hvert store tre starter her."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici se plantează o sămânță. De aici începe fiecare copac falnic."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насінину посаджено. Кожне велике дерево починається тут."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seme è piantato. Ogni grande albero inizia qui."
          }
        },
