    "Anything you want to remember about today?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything you want to remember about today?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du dir etwas von heute merken?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите что-то запомнить об этом дне?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chceš si z dneška něco zapamatovat?"
