    "No entries yet. Use the pencil to write your first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No entries yet. Use the pencil to write your first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Einträge. Tippe auf den Stift für deinen ersten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записей пока нет. Нажмите на карандаш, чтобы написать первую."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nemáte žádné záznamy. Klepnutím na tužku napište první."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga inlägg ännu. Tryck på pennan för att skriva ditt första."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä merkintöjä. Napauta kynää ja kirjoita ensimmäinen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen notities. Tik op het potlood om je eerste te schrijven."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay entradas. Toca el lápiz para escribir la primera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dagbogsnotater endnu. Tryk på blyanten for at skrive dit første."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wpisów. Stuknij ikonę ołówka i dodaj pierwszy wpis."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nemáš žiadne záznamy. Ťukni na ceruzku a napíš prvý."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen innlegg ennå. Trykk på blyanten for å skrive det første."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există încă înregistrări. Folosiți pictograma creion pentru a scrie prima notă."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записів поки немає. Торкніться олівця, щоб створити перший запис."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora voci. Tocca la matita per scrivere la prima."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有日记。点按铅笔图标写下第一篇。"
          }
        }
      }
    },
