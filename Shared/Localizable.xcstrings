    "Recovery starts with a decision. This is yours, for today and the days that follow.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery starts with a decision. This is yours, for today and the days that follow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genesung beginnt mit einer Entscheidung. Das ist deine, für heute und die Tage, die folgen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказ от никотина начинается с решения. Сегодня это ваше решение, и на следующие дни тоже."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cesta k životu bez nikotinu začíná rozhodnutím. Dnes je to vaše rozhodnutí, stejně jako v dalších dnech."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återhämtningen börjar med ett beslut. Detta är ditt, för idag och de dagar som följer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toipuminen alkaa päätöksestä. Tänään teit omasi, ja sama päätös kantaa tulevinakin päivinä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel begint met een beslissing. Vandaag heb je die genomen, en je kunt die de komende dagen opnieuw nemen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación empieza con una decisión. Hoy tomaste la tuya, y puedes renovarla cada día que venga."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det begynder med et valg. Du har truffet dit for i dag og dagene, der følger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana zaczyna się od decyzji. To twoja decyzja na dziś i na kolejne dni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena sa začína rozhodnutím. Toto je tvoje rozhodnutie na dnes aj na ďalšie dni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endring starter med en beslutning. Dette er din beslutning for i dag og dagene fremover."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcursul începe cu o decizie. Este alegerea dvs., astăzi și în zilele următoare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шлях починається з рішення. Сьогодні й надалі це ваше рішення."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cambiamento inizia con una decisione. Oggi e nei giorni a venire, la scelta è tua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变始于一个决定。今天以及今后的日子，都由你来选择。"
          }
        }
      }
    },
