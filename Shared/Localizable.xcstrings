    "The seed is settling in. Your journey starts here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The seed is settling in. Your journey starts here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Samen findet seinen Platz. Hier beginnt dein Weg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семя приживается. Ваш путь начинается здесь."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Semínko se ujímá. Tady začíná vaše cesta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fröet slår rot. Din resa börjar här."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siemen juurtuu. Matkasi alkaa tästä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zaadje wortelt. Hier begint je reis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La semilla empieza a echar raíces. Tu camino comienza aquí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Frøet slår rod. Din rejse begynder her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasiono zaczyna się przyjmować. Tu zaczyna się twoja droga."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Semienko sa ujíma. Tu sa začína tvoja cesta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frøet begynner å slå rot. Reisen din starter her."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sămânța prinde rădăcini. Parcursul dvs. începe aici."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насінина приживається. Тут починається ваш шлях."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il seme sta attecchendo. Il tuo percorso comincia qui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "种子正在扎根。你的旅程从这里开始。"
          }
        }
      }
    },
    "This is near the top of it. These %@ climb fast and then they stop climbing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is near the top of it. These %@ climb fast and then they stop climbing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese %1$@ klettern schnell und dann hören sie auf zu klettern."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, пик уже близко. Сила %1$@ быстро нарастает, затем рост прекращается."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrchol je blízko. Síla %1$@ rychle roste a pak se ustálí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Suget är nästan som starkast. Ditt %1$@ stiger snabbt och börjar sedan avta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet lähellä huippua. %1$@ voimistuvat nopeasti, sitten niiden voimakkuus ei enää kasva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zit bijna op de piek. Je %1$@ nemen snel toe en vlakken daarna af."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás cerca del punto máximo. Las %1$@ aumentan rápido y luego dejan de subir."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nærmer dig toppen. Din %1$@ stiger hurtigt og flader derefter ud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głód nikotynowy jest już niemal u szczytu. Te %1$@ szybko narastają, a potem przestają się nasilać."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuť na nikotín je takmer na vrchole. Tvoje %1$@ rýchlo narastajú a potom sa prestanú zintenzívňovať."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikotinsuget er nesten på topp. %1$@ øker raskt før intensiteten flater ut."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunteți aproape de vârful poftei. %1$@ pot deveni intense rapid, apoi se stabilizează."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це майже пік. %1$@ швидко посилюються, а потім їхня інтенсивність стабілізується."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il picco è vicino. L’intensità delle %1$@ aumenta rapidamente, poi si stabilizza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这通常接近高峰。你的%1$@会迅速增强，之后便不再加剧。"
          }
        }
      }
    },
