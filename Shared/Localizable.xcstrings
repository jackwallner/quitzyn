    "Free, confidential help is available any time. Reaching out is a strength, not a setback.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free, confidential help is available any time. Reaching out is a strength, not a setback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose, vertrauliche Hilfe gibt es jederzeit. Sich zu melden ist Stärke, kein Rückschritt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатная конфиденциальная помощь доступна в любое время. Обратиться за ней не слабость, а сила."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatná a důvěrná pomoc je k dispozici kdykoli. Ozvat se je síla, ne prohra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fri, konfidentiell hjälp är tillgänglig när som helst. Att nå ut är en styrka, inte ett bakslag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksutonta ja luottamuksellista apua on saatavilla milloin vain. Avun pyytäminen on vahvuutta, ei takaisku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis, vertrouwelijke hulp is altijd beschikbaar. Hulp zoeken is een kracht, geen terugval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay ayuda gratuita y confidencial en cualquier momento. Pedirla es una fortaleza, no un retroceso."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis, fortrolig hjælp er tilgængelig når som helst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatna, poufna pomoc jest dostępna o każdej porze. Sięgnięcie po nią to siła, nie porażka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatná, dôverná pomoc je k dispozícii kedykoľvek. Dosiahnutie je sila, nie neúspech."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis og konfidensiell hjelp er tilgjengelig når som helst. Å ta kontakt er en styrke, ikke et tilbakeslag."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajutor gratuit, confidențial este disponibil oricând. A ajunge afară este o putere, nu un regres."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовна конфіденційна допомога доступна будь-коли. Звернутися по неї не поразка, а сила."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aiuto gratuito e riservato è sempre disponibile. Chiedere aiuto è un punto di forza, non un passo indietro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时都可以获得免费,保密的帮助,接触是一种力量,而不是挫折."
          }
        }
      }
    },
    "Full access to your garden, journal, health timeline, and savings. Free until your trial ends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full access to your garden, journal, health timeline, and savings. Free until your trial ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volle Funktionen für Garten, Tagebuch, Gesundheit und Ersparnisse während der Testphase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный доступ к саду, дневнику, здоровью и экономии на время пробного периода."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plný přístup k zahradě, deníku, zdraví a úsporám po dobu zkoušky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Full tillgång till trädgård, dagbok, hälsa och besparingar under provperioden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysi pääsy puutarhaan, päiväkirjaan, terveyteen ja säästöihin kokeilun ajaksi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige toegang tot tuin, dagboek, gezondheid en besparingen tijdens je proefperiode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso completo al jardín, diario, salud y ahorros durante la prueba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuld adgang til have, dagbog, sundhed og besparelser i prøveperioden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełny dostęp do ogrodu, dziennika, zdrowia i oszczędności na czas okresu próbnego."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plný prístup do záhrady, denníka, zdravia a úspor počas skúšobnej doby."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Full tilgang til hage, dagbok, helse og sparing i prøveperioden."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acces complet la grădină, jurnal, sănătate și economii pe durata probei."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повний доступ до саду, щоденника, здоров’я й заощаджень на час пробного періоду."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso completo a giardino, diario, salute e risparmi durante la prova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用期间可完整使用花园、日记、健康追踪和储蓄功能。"
          }
        }
      }
    },
