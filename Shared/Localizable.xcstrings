    "Bloom+ plans are temporarily unavailable. You can retry or continue free.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ plans are temporarily unavailable. You can retry or continue free."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ pläne sind vorübergehend nicht verfügbar sie können es versuchen oder kostenlos fortfahren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планы Bloom+ временно недоступны. Вы можете повторить или продолжить бесплатно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ plány jsou dočasně nedostupné. Můžete znovu vyzkoušet nebo pokračovat zdarma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+-planer är tillfälligt otillgängliga. Du kan retry eller fortsätta gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+-suunnitelmat eivät ole tilapäisesti käytettävissä. Voit yrittää uudelleen tai jatkaa ilmaiseksi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ plannen zijn tijdelijk niet beschikbaar. U kunt het opnieuw proberen of verder gratis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los planes Bloom+ no están disponibles temporalmente. Usted puede volver a entrar o continuar libre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ planer er midlertidigt ikke tilgængelige. Du kan prøve igen eller fortsætte gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plany Bloom+ są tymczasowo niedostępne. Możesz spróbować ponownie lub kontynuować wolny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plány Bloom+ sú dočasne nedostupné. Môžete sa vrátiť alebo pokračovať zadarmo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ planer er midlertidig utilgjengelige. Du kan prøve eller fortsette gratis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planurile Bloom+ sunt temporar indisponibile. Puteți încerca sau continua gratuit."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плани Bloom+ тимчасово недоступні. Спробуйте ще раз або продовжуйте безкоштовно."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I piani Bloom+ sono temporaneamente non disponibili. È possibile riprovare o continuare gratuitamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ 计划暂时无法使用。 您可以重试或免费继续 。"
          }
        }
      }
    },
    "Bloom+ unlocks every species so you can switch your tree whenever you like. Your streak grows whichever one you pick.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ unlocks every species so you can switch your tree whenever you like. Your streak grows whichever one you pick."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ schaltet jede Art frei, damit du deinen Baum wechseln kannst, wann du willst. Deine Serie wächst bei jedem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ открывает все виды, чтобы менять дерево когда угодно. Серия растёт на любом из них."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ odemkne všechny druhy, takže strom můžeš měnit, kdy chceš. Tvá série roste u kteréhokoli z nich."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ låser upp varje art så att du kan byta ditt träd när du vill. Din strimma växer beroende på vilken du väljer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ avaa kaikki lajit, joten voit vaihtaa puuta milloin haluat. Putkesi kasvaa, valitsitpa minkä tahansa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ ontgrendelt elke soort, zodat je je boom kunt wisselen wanneer je wilt. Je reeks groeit bij elke keuze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ desbloquea todas las especies para cambiar tu árbol cuando quieras. Tu racha crece con cualquiera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ låser alle arter op, så du kan skifte træ, når du vil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ odblokowuje wszystkie gatunki, więc możesz zmieniać drzewo, kiedy chcesz. Seria rośnie przy każdym."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ odomkne každý druh, takže si môžete prepnúť svoj strom, kedykoľvek sa vám páči. Vaša pruh rastie podľa toho, ktorý si vyberiete."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ låser opp alle arter, så du kan bytte tre når du vil. Rekken vokser uansett hvilket du velger."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ deblochează fiecare specie astfel încât să puteți schimba copacul ori de câte ori doriți. Streak crește oricare dintre cele pe care le alegeți."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ відкриває всі види, щоб змінювати дерево будь-коли. Серія росте на будь-якому."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ sblocca tutte le specie per cambiare albero quando vuoi. La tua serie cresce con qualunque scelta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ 解锁每个物种, 这样您可以在您喜欢的时候切换您的树。 您的花序会长出您所选的树 。"
          }
        }
      }
    },
