          "stringUnit": {
            "state": "translated",
            "value": "Dagtelleren starter på null igjen. Historikken beholdes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contorul de zi va reporni la zero."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічильник днів почнеться з нуля. Історія збережеться."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contatore ripartirà da zero. La tua cronologia resta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的日间计数器将在零点重新开始。 您的历史被保存 。"
          }
        }
      }
    },
    "Your day counter, craving mode, widget and Watch stay free, forever": {
