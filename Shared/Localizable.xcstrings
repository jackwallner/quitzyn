    "Your garden is growing. Check in today if you're nicotine-free.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden is growing. Check in today if you're nicotine-free."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Garten wächst. Trag den heutigen Tag ein, wenn du nikotinfrei bist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой сад растёт. Отметь сегодняшний день, если сегодня ты без никотина."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje zahrada roste. Zapiš dnešní den, pokud jsi dnes bez nikotinu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din trädgård växer. Logga dagen om du är nikotinfri i dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarhasi kasvaa. Kirjaa tämä päivä, jos olet tänään ilman nikotiinia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tuin groeit. Registreer vandaag als je nicotinevrij bent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu jardín crece. Registra el día si hoy estás sin nicotina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din have vokser. Registrér dagen, hvis du er nikotinfri i dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój ogród rośnie. Zapisz dzisiejszy dzień, jeśli jesteś dziś bez nikotyny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja záhrada rastie. Zaznamenaj dnešný deň, ak si dnes bez nikotínu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagen din vokser. Logg dagen hvis du er nikotinfri i dag."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Grădina ta crește. Înregistrează ziua de azi dacă ești fără nicotină."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій сад росте. Познач цей день, якщо сьогодні ти без нікотину."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo giardino cresce. Registra la giornata se oggi sei senza nicotina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的花园正在生长。如果今天没有摄入尼古丁，就记录这一天。"
          }
        }
      }
    },
    "Your tree joins the grove. A new sapling begins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tree joins the grove. A new sapling begins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Baum zieht in den Hain. Ein neuer Setzling wächst heran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоё дерево становится частью рощи. Рядом растёт новый саженец."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj strom se přidává do háje. Začíná růst nová sazenice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt träd får en plats i lunden. En ny planta börjar växa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puusi liittyy lehtoon. Uusi taimi alkaa kasvaa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je boom krijgt een plek in het bosje. Een nieuw boompje groeit op."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu árbol se une a la arboleda. Empieza a crecer un nuevo brote."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit træ får plads i lunden. En ny spire begynder at vokse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje drzewo dołącza do gaju. Zaczyna rosnąć nowa sadzonka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj strom sa pridáva do hája. Začína rásť nový stromček."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Treet ditt får plass i lunden. En ny spire begynner å vokse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copacul tău intră în livadă. Un puiet nou începe să crească."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоє дерево стає частиною гаю. Поруч росте новий саджанець."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo albero entra nel boschetto. Una nuova piantina inizia a crescere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的树加入树林，一株新树苗开始生长。"
          }
        }
