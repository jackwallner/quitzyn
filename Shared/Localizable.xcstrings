    "Free, confidential help is available any time. Reaching out is a strength, not a setback.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free, confidential help is available any time. Reaching out is a strength, not a setback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose, vertrauliche Hilfe gibt es jederzeit. Hilfe anzunehmen zeigt Stärke und ist kein Rückschritt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатная конфиденциальная помощь доступна в любое время. Обратиться за помощью значит проявить силу, это не шаг назад."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatná a důvěrná pomoc je k dispozici kdykoli. Požádat o pomoc je projev síly, nikoli krok zpět."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fri, konfidentiell hjälp är tillgänglig när som helst. Att nå ut är en styrka, inte ett bakslag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksutonta ja luottamuksellista apua on saatavilla milloin vain. Avun pyytäminen on vahvuutta, ei takaisku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis en vertrouwelijke hulp is altijd beschikbaar. Contact opnemen getuigt van kracht, niet van een tegenslag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay ayuda gratuita y confidencial en cualquier momento. Pedirla demuestra fortaleza, no es un contratiempo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis og fortrolig hjælp er altid tilgængelig. At række ud er et tegn på styrke, ikke et tilbageslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatna i poufna pomoc jest dostępna o każdej porze. Poproszenie o nią to oznaka siły, nie porażka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatná a dôverná pomoc je dostupná kedykoľvek. Požiadať o ňu je prejav sily, nie krok späť."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis og konfidensiell hjelp er tilgjengelig når som helst. Å be om hjelp er en styrke, ikke et tilbakeslag."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajutorul gratuit și confidențial este disponibil oricând. Să cereți ajutor este un semn de curaj, nu un pas înapoi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовна конфіденційна допомога доступна будь-коли. Звернутися по неї це прояв сили, а не крок назад."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aiuto gratuito e riservato è sempre disponibile. Chiedere aiuto è un punto di forza, non un passo indietro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你随时都能获得免费、保密的帮助。主动求助是勇气，不是退步。"
          }
        }
      }
    },
    "Full access to your garden, journal, health timeline, and savings. Free until your trial ends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full access to your garden, journal, health timeline, and savings. Free until your trial ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voller Zugriff auf Garten, Tagebuch, Gesundheitsverlauf und Ersparnisse. Bis zum Ende deiner Testphase kostenlos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До конца пробного периода у вас будет полный доступ к саду, дневнику, графику восстановления здоровья и сбережениям."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do konce zkušebního období máte plný přístup k zahradě, deníku, časové ose zotavování a úsporám."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Full tillgång till trädgården, dagboken, hälsotidslinjen och besparingarna. Gratis tills provperioden tar slut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysi käyttöoikeus puutarhaan, päiväkirjaan, terveyden palautumisen aikajanaan ja säästöihin kokeilujakson loppuun asti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige toegang tot je tuin, dagboek, gezondheidstijdlijn en besparingen. Gratis tot je proefperiode afloopt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso completo a tu jardín, diario, cronología de recuperación de salud y ahorros. Gratis hasta que termine el periodo de prueba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuld adgang til din have, dagbog, sundhedstidslinje og besparelser. Gratis, indtil prøveperioden slutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełny dostęp do ogrodu, dziennika, osi czasu zdrowia i informacji o oszczędnościach. Za darmo do końca okresu próbnego."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plný prístup k záhrade, denníku, časovej osi zdravia a úsporám. Zadarmo do konca skúšobného obdobia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Full tilgang til hagen, dagboken, helsetidslinjen og besparelsene dine. Gratis til prøveperioden er over."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acces complet la grădină, jurnal, cronologia sănătății și economii. Gratuit până la încheierea perioadei de probă."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повний доступ до саду, щоденника, часової шкали здоров’я та заощаджень. Безкоштовно до завершення пробного періоду."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso completo al giardino, al diario, alla cronologia della salute e ai risparmi. Gratis fino alla fine della prova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用期内可完整使用花园、日记、健康时间线和省钱统计。"
          }
        }
      }
    },
