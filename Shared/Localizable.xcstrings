    "Based on sessions you rode out, not an average across everyone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on sessions you rode out, not an average across everyone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basiert auf den Sitzungen, die du durchgestanden hast, nicht auf einem allgemeinen Durchschnitt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основано на пережитых вами сеансах, а не на среднем показателе по всем пользователям."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vychází ze sezení, která jste zvládli, nikoli z průměru všech uživatelů."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygger på de sug du tog dig igenom, inte på ett genomsnitt för alla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perustuu selättämiisi nikotiininhimoihin, ei kaikkien keskiarvoon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaseerd op nicotinetrek die je hebt doorstaan, niet op een gemiddelde van iedereen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se basa en las sesiones en que superaste las ansias de nicotina, no en un promedio de todas las personas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseret på de tilfælde af nikotintrang, du har modstået, ikke på et gennemsnit for alle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazuje na twoich sesjach, podczas których udało ci się przeczekać głód nikotynowy, a nie na średniej dla wszystkich."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vychádza z tvojich zvládnutých epizód, nie z priemeru všetkých používateľov."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygger på nikotinsuget du kom deg gjennom, ikke et gjennomsnitt for alle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se bazează pe episoadele de poftă cărora le-ați făcut față, nu pe o medie generală."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На основі епізодів, які вам вдалося пережити, а не середнього показника для всіх."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si basa sugli episodi di voglia che hai superato, non su una media generale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你挺过渴求的记录，而非所有用户的平均值。"
          }
        }
      }
    },
