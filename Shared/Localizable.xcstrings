        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ maksaa suunnilleen puolentoista päivän nikotiinipussien verran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kost ongeveer evenveel als anderhalve dag nicotinezakjes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cuesta aproximadamente lo mismo que un día y medio de bolsitas de nicotina."
          }
        },
        "da": {
