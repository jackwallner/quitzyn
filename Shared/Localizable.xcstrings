    "Branches are reaching wider. The shape is emerging.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Branches are reaching wider. The shape is emerging."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Äste greifen weiter aus. Die Form zeichnet sich ab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ветви раскидываются шире. Форма проявляется."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Větve sahají dál. Tvar se začíná rýsovat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenar når bredare. Formen är framväxande."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oksat kurottuvat leveämmälle. Muoto alkaa hahmottua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De takken reiken breder. De vorm wordt zichtbaar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ramas se extienden. La forma empieza a verse."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brancher er ved at blive bredere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gałęzie sięgają szerzej. Kształt się wyłania."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobočky sa stávajú širšími."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Greinene strekker seg bredere. Formen trer frem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramurile se lărgesc."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гілки розкидаються ширше. Форма проявляється."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I rami si allargano. La forma sta emergendo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "树枝伸向更宽的地道,形状正在出现."
          }
        }
      }
    },
