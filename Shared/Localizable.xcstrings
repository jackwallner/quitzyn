    "Track every dollar and pouch you avoid, plus the rest of Bloom+.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track every dollar and pouch you avoid, plus the rest of Bloom+."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge jeden gesparten Euro und jeden vermiedenen Nikotinbeutel, dazu alle weiteren Bloom+-Funktionen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте сэкономленные деньги и каждый неиспользованный никотиновый пауч, а также другие функции Bloom+."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte ušetřené peníze i nepoužité nikotinové sáčky a využívejte další funkce Bloom+."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll koll på pengarna och nikotinpåsarna du sparar, plus allt annat i Bloom+."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa säästämiäsi dollareita ja väliin jääviä nikotiinipusseja sekä kaikkea muuta Bloom+."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd bij hoeveel geld en nicotinezakjes je bespaart, plus de rest van Bloom+."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva la cuenta del dinero que ahorras y de las bolsitas de nicotina que evitas, además del resto de Bloom+."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold styr på pengene og nikotinposerne, du sparer, plus resten af Bloom+."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź zaoszczędzone pieniądze i niewykorzystane saszetki nikotynowe, a także korzystaj z pełnego Bloom+."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj ušetrené peniaze a nespotrebované nikotínové vrecúška aj všetky ďalšie funkcie Bloom+."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg med på pengene du sparer og nikotinposene du unngår, pluss resten av Bloom+."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmăriți economiile și pliculețele cu nicotină pe care le evitați, plus restul Bloom+."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте заощадження й нікотинові пакетики, яких вам вдалося уникнути, а також користуйтеся рештою Bloom+."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia dei dollari e delle bustine di nicotina che eviti, insieme al resto di Bloom+."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录每一笔省下的钱和每一袋少用的尼古丁袋，以及 Bloom+ 的其他功能。"
          }
        }
      }
    },
    "Track your nicotine-free days, grow your garden, watch your health return.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track your nicotine-free days, grow your garden, watch your health return."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge deine nikotinfreien Tage, lass deinen Garten wachsen und beobachte deine gesundheitliche Entwicklung."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте дни без никотина, выращивайте сад и следите за своим самочувствием."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte dny bez nikotinu, nechte růst zahradu a všímejte si změn ve svém zdraví."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ dina nikotinfria dagar, odla trädgården och se hur hälsan återhämtar sig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa nikotiinittomia päiviäsi, kasvata puutarhaasi ja seuraa vointisi kohenemista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg je nicotinevrije dagen, laat je tuin groeien en zie hoe je gezondheid zich herstelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue tus días sin nicotina, cultiva tu jardín y observa cómo se recupera tu salud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg dine dage uden nikotin, dyrk haven, og se din sundhed komme sig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź dni bez nikotyny, pielęgnuj ogród i obserwuj zmiany w swoim zdrowiu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj dni bez nikotínu, pestuj svoju záhradu a všímaj si zmeny vo svojom zdraví."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg med på dagene uten nikotin, dyrk hagen og legg merke til helseforandringene."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmăriți zilele fără nicotină, cultivați grădina și observați schimbările pozitive ale sănătății."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте дні без нікотину, вирощуйте сад і спостерігайте за позитивними змінами у здоров’ї."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia dei giorni senza nicotina, fai crescere il giardino e osserva i miglioramenti del tuo benessere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录无尼古丁天数，培育花园，关注身体变化。"
          }
        }
      }
    },
