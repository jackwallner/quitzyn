    "If I had a pouch today, what would I lose?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If I had a pouch today, what would I lose?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was würde ich heute verlieren, wenn ich einen Nikotinbeutel nähme?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что я потеряю, если сегодня использую никотиновый пауч?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co můžu ztratit, když dnes sáhnu po nikotinovém sáčku?"
