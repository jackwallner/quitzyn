    "A seed is planted. Every great tree starts here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A seed is planted. Every great tree starts here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Samen ist gesetzt. Jeder große Baum beginnt hier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семя посажено. Каждое большое дерево начинается здесь."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Semínko je zasazeno. Tady začíná každý velký strom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett frö planteras. Varje bra träd börjar här."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siemen on istutettu. Jokainen suuri puu alkaa tästä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een zaadje geplant. Elke grote boom begint hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semilla plantada. Todo gran árbol empieza aquí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et frø bliver plantet. Alle store træer begynder sådan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasiane nasionko. Tak zaczyna się każde wielkie drzewo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasadené semienko. Takto sa začína každý veľký strom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et frø er sådd. Slik begynner alle store trær."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici este plantată o sămânță. Așa începe orice copac măreț."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насінину посаджено. Так починається історія кожного великого дерева."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seme viene piantato. Ogni grande albero comincia da qui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "种下一颗种子。每棵大树都始于此。"
          }
        }
      }
    },
    "A seedling stands tall. Roots are taking hold.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A seedling stands tall. Roots are taking hold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sämling steht aufrecht. Die Wurzeln fassen Halt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Саженец стоит прямо. Корни укрепляются."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sazenice se tyčí vzhůru a její kořeny se ujímají."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En planta sträcker sig mot ljuset. Rötterna börjar få fäste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taimi seisoo ryhdikkäänä. Juuret alkavat tarttua maahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een jonge boom staat rechtop. De wortels beginnen zich te hechten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La plántula se alza. Sus raíces empiezan a afianzarse."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En lille spire strækker sig op. Rødderne begynder at få fat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadzonka rośnie prosto, a jej korzenie dobrze się przyjmują."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadenica rastie vzpriamene a jej korene sa ujímajú."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En småplante står støtt, og røttene begynner å feste seg."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puietul se înalță. Rădăcinile prind putere."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Саджанець піднявся. Коріння міцно тримається в ґрунті."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una piantina si erge. Le radici stanno attecchendo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "树苗挺立起来，根系开始扎稳。"
          }
        }
      }
    },
    "A slip can only be taken back while it's the most recent one on your record.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A slip can only be taken back while it's the most recent one on your record."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ausrutscher lässt sich nur zurücknehmen, solange er der neueste ist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срыв можно отменить, только если он последний в истории."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklouznutí lze vrátit jen tehdy, pokud je ve vašem záznamu nejnovější."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett snedsteg kan bara ångras så länge det är det senaste i din historik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit perua retkahduksen vain, jos se on kirjauksistasi viimeisin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt een misstap alleen ongedaan maken zolang het de meest recente is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo puedes deshacer un desliz si es el más reciente de tu historial."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kun fortryde en smutter, så længe den er den seneste i din historik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potknięcie można cofnąć tylko do momentu zarejestrowania kolejnego."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošmyknutie môžeš vziať späť, len kým je v záznamoch to najnovšie."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bare angre en glipp så lenge den er den nyeste i historikken din."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O scăpare poate fi anulată numai cât timp este ultima înregistrată."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зрив можна скасувати, лише доки він є останнім у вашому журналі."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi annullare uno scivolone solo finché è l’ultimo registrato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有记录中最新的一次失手可以撤销。"
          }
        }
      }
    },
