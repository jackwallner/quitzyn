    "Switch anytime. Your day count and growth carry over to whichever tree you choose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch anytime. Your day count and growth carry over to whichever tree you choose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jederzeit wechselbar. Tage und Wachstum gehen auf jeden Baum über, den du wählst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте в любой момент. Дни и рост переходят на любое выбранное дерево."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měň kdykoli. Počet dní i růst přejdou na jakýkoli strom, který si vybereš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växla när som helst. Din dag räknas och tillväxt bär över till vilket träd du väljer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda milloin vain. Päivät ja kasvu siirtyvät mihin tahansa valitsemaasi puuhun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel wanneer je wilt. Je dagen en groei gaan mee naar elke boom die je kiest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia cuando quieras. Tus días y tu crecimiento pasan al árbol que elijas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift når som helst. Din dag tæller og vækst overføre til det træ, du vælger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniaj w dowolnej chwili. Dni i wzrost przechodzą na wybrane drzewo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepnúť kedykoľvek. Váš deň počítať a rast preniesť na ktorý strom si vyberiete."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt når du vil. Dagene og veksten følger med til treet du velger."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbaţi oricând. Numărul de zile şi creşterea duce la copacul pe care îl alegeţi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюйте будь-коли. Дні й ріст переходять на будь-яке вибране дерево."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia quando vuoi. Giorni e crescita passano all'albero che scegli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时切换,你的一天数和成长 都延续到你选择的树上"
          }
        }
      }
    },
