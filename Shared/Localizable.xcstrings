    "You've saved %@ while nicotine-free. Keep it growing with tools that support your progress.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$@ gespart, während du nikotinfrei bleibst. Mit Bloom+ kannst du deinen Fortschritt weiter unterstützen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставаясь без никотина, вы уже сэкономили %1$@. Продолжайте копить с помощью инструментов Bloom+, которые поддерживают ваш прогресс."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během života bez nikotinu jste už ušetřili %1$@. S dalšími nástroji Bloom+ můžete v pokroku pokračovat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har sparat %1$@ genom att vara nikotinfri. Bloom+ hjälper dig att fortsätta framåt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet säästänyt %1$@ pysymällä nikotiinittomana. Bloom+ auttaa jatkamaan."
          }
        },
        "nl": {
