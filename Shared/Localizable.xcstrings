    "Reminders are framed around your pledge.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are framed around your pledge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen beziehen sich auf dein Versprechen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания опираются на ваше обязательство."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínky vycházejí z tvého závazku."
