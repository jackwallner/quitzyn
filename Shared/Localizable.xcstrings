    "What did I do today that my future self will thank me for?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What did I do today that my future self will thank me for?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was habe ich heute getan, wofür mir mein zukünftiges Ich danken wird?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За что сегодня моё будущее «я» скажет мне спасибо?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co z dneška ocení moje budoucí já?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad gjorde jag idag för att mitt framtida jag ska tacka mig för?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä tein tänään, mistä tuleva minäni kiittää?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat deed ik vandaag waar mijn toekomstige ik me dankbaar voor is?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué hice hoy que mi yo del futuro me agradecerá?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad har jeg gjort i dag, som mit fremtidige jeg vil takke mig for?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co udało mi się dziś zrobić, za co podziękuje mi moje przyszłe ja?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo sa mi dnes podarilo a za čo mi moje budúce ja poďakuje?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva gjorde jeg i dag som mitt fremtidige jeg vil takke meg for?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce am făcut astăzi pentru care îmi va mulțumi versiunea mea din viitor?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що з моїх сьогоднішніх вчинків стане подарунком для мене в майбутньому?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per cosa mi ringrazierò in futuro, grazie a ciò che ho fatto oggi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天我做了什么，让未来的自己会感谢我？"
          }
        }
      }
    },
    "What did my body thank me for today?": {
