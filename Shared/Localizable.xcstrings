    "Bloom+ plans are temporarily unavailable. You can retry or continue free.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ plans are temporarily unavailable. You can retry or continue free."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+-Pläne sind vorübergehend nicht verfügbar. Versuch es noch einmal oder nutze die kostenlose Version."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки Bloom+ временно недоступны. Повторите попытку или продолжайте бесплатно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatná Bloom+ jsou dočasně nedostupná. Zkuste to znovu, nebo pokračujte zdarma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+ är tillfälligt otillgängligt. Försök igen eller fortsätt gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+-tilaukset eivät ole juuri nyt saatavilla. Yritä uudelleen tai jatka maksutta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+-abonnementen zijn tijdelijk niet beschikbaar. Probeer het opnieuw of ga gratis verder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones de Bloom+ no están disponibles temporalmente. Inténtalo de nuevo o continúa gratis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom+-abonnementer er midlertidigt utilgængelige. Prøv igen, eller fortsæt gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plany Bloom+ są chwilowo niedostępne. Spróbuj ponownie albo korzystaj dalej bezpłatnie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
