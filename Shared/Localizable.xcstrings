    "General wellness information, not medical advice. Timelines vary from person to person. For medical concerns, talk to a healthcare professional.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General wellness information, not medical advice. Timelines vary from person to person. For medical concerns, talk to a healthcare professional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemeine Gesundheitsinformationen, keine medizinische Beratung. Zeitverläufe sind individuell. Bei gesundheitlichen Fragen wende dich an medizinisches Fachpersonal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общая информация о здоровье, не медицинский совет. Сроки у всех разные. По вопросам здоровья обратитесь к медицинскому специалисту."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecné informace o zdraví, nikoli lékařské rady. Průběh se u každého liší. Zdravotní potíže prober se zdravotníkem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allmän information om välmående, inte medicinsk rådgivning. Tidsförlopp varierar från person till person. Prata med vårdpersonal om du har medicinska frågor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yleistä hyvinvointitietoa, ei lääketieteellistä neuvontaa. Muutokset ovat yksilöllisiä. Terveysasioissa käänny terveydenhuollon ammattilaisen puoleen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Algemene informatie over welzijn, geen medisch advies. Het verloop verschilt per persoon. Bespreek medische vragen met een zorgverlener."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información general sobre bienestar, no es consejo médico. Los plazos varían de una persona a otra. Para dudas médicas, consulta a un profesional sanitario."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Generel information om velvære, ikke lægelig rådgivning. Forløb varierer fra person til person. Tal med sundhedspersonale om helbredsspørgsmål."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogólne informacje o zdrowiu, nie porada medyczna. Przebieg jest indywidualny. W sprawach zdrowotnych skonsultuj się z personelem medycznym."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všeobecné informácie o zdraví, nie lekárske rady. Priebeh sa u každého líši. Zdravotné otázky preber so zdravotníckym pracovníkom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Generell informasjon om velvære, ikke medisinske råd. Forløp varierer fra person til person. Snakk med helsepersonell hvis du har helsespørsmål."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Informații generale despre starea de bine, nu sfaturi medicale. Evoluția diferă de la o persoană la alta. Pentru probleme de sănătate, discută cu un profesionist medical."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загальна інформація про самопочуття, не медична порада. Перебіг у кожного різний. Із медичними питаннями зверніться до медичного фахівця."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informazioni generali sul benessere, non consigli medici. I tempi variano da persona a persona. Per questioni di salute, rivolgiti a un professionista sanitario."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一般健康与身心状态信息，不构成医疗建议。每个人的变化时间不同。如有医疗问题，请咨询医疗专业人员。"
          }
        }
      }
    },
