    "Journal privately through the hard days": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal privately through the hard days"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe auch an schweren Tagen in Ruhe Tagebuch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите личный дневник даже в трудные дни"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pište si soukromě do deníku i v těžkých dnech"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dagbok privat när dagarna känns tunga"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita päiväkirjaa yksityisesti vaikeinakin päivinä"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf ook op moeilijke dagen privé in je dagboek"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en privado en tu diario durante los días difíciles"
          }
        },
        "da": {
