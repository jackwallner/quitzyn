    "An evergreen pine with cloud-like needle tiers and a gnarled, weathered trunk.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An evergreen pine with cloud-like needle tiers and a gnarled, weathered trunk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine immergrüne Kiefer mit wolkenartigen Nadelstufen und knorrigem, verwittertem Stamm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечнозелёная сосна с ярусами хвои, похожими на облака, и узловатым обветренным стволом."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stálezelená borovice s patry jehlic jako mraky a sukovitým, ošlehaným kmenem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En vintergröna tallrik med molnliknande nålnivåer och en gnarled, väderstammar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikivihreä mänty pilvimäisine neulaskerroksineen ja kyhmyisine, sään pieksemine runkoineen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een groenblijvende den met wolkachtige naaldlagen en een knoestige, verweerde stam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pino perenne con capas de agujas como nubes y un tronco nudoso y curtido."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En stedsegrønne fyr med sky- lignende kanylelag og en gnubbet, vævet stamme."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zimozielona sosna z piętrami igieł jak chmury i sękatym, ogorzałym pniem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále zelená borovica s oblačno-ako ihly úrovní a zadrhnutý, prevetraný kmeň."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En eviggrønn furu med skylignende nåletrinn og en knudrete, værbitt stamme."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pin veşnic verde cu nivele de ac ca un nor şi un trunchi noduros şi netezit."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вічнозелена сосна з ярусами хвої, схожими на хмари, і вузлуватим обвітреним стовбуром."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pino sempreverde con palchi di aghi come nuvole e un tronco nodoso e segnato dal tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有云状针叶的常绿松 和被咬的风化树干"
          }
        }
      }
    },
