    "Project the year ahead, not just the days behind": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project the year ahead, not just the days behind"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blicke aufs kommende Jahr, nicht nur auf die vergangenen Tage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
