          "stringUnit": {
            "state": "translated",
            "value": "Plany są chwilowo niedostępne. Spróbuj ponownie za chwilę."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plány sú dočasne nedostupné. Skús to o chvíľu znova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementene er midlertidig utilgjengelige. Prøv igjen om litt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planurile nu sunt disponibile temporar. Încercați din nou peste puțin timp."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плани тимчасово недоступні. Спробуйте ще раз за мить."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I piani non sono al momento disponibili. Riprova tra poco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案暂时不可用，请稍后重试。"
          }
        }
      }
    },
    "Plus %@ pouches you won't put in. That's the nicotine your body never has to process.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus %@ pouches you won't put in. That's the nicotine your body never has to process."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außerdem vermeidest du %1$@ Nikotinbeutel. So muss dein Körper dieses Nikotin nicht verarbeiten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы также избежали %1$@ никотиновых паучей. Этот никотин не придётся перерабатывать вашему организму."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhnete se také použití %1$@ nikotinových sáčků. Vaše tělo nebude muset tento nikotin zpracovávat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessutom slipper du använda %1$@ nikotinpåsar. Då behöver kroppen aldrig ta hand om det nikotinet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisäksi %1$@ nikotiinipussia jää käyttämättä. Kehosi ei joudu käsittelemään niiden nikotiinia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vermijdt bovendien %1$@ nicotinezakjes. Je lichaam hoeft die nicotine niet te verwerken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Además, evitarás %1$@ bolsitas de nicotina. Tu cuerpo no tendrá que procesar esa nicotina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Derudover undgår du %1$@ nikotinposer. Så skal kroppen ikke behandle den nikotin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tego unikniesz %1$@ saszetek nikotynowych. Organizm nie będzie musiał przetwarzać zawartej w nich nikotyny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Navyše sa vyhneš %1$@ nikotínovým vrecúškam. Tvoje telo nebude musieť spracovať nikotín, ktorý obsahujú."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I tillegg unngår du %1$@ nikotinposer. Kroppen slipper dermed å omsette den nikotinen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În plus, evitați %1$@ pliculețe cu nicotină. Organismul dvs. nu va mai avea de metabolizat acea nicotină."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Крім того, ви не використаєте %1$@ нікотинових пакетиків. Організму не доведеться переробляти цей нікотин."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In più, eviterai %1$@ bustine di nicotina. Il tuo corpo non dovrà metabolizzare quella nicotina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另外，你将少用%1$@袋尼古丁，身体也就不必代谢这些尼古丁。"
          }
        }
      }
    },
