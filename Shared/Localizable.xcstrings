    "%@ Keep the full garden, or cancel any time before it renews.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Keep the full garden, or cancel any time before it renews."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Behalte den ganzen Garten oder kündige jederzeit vor der Verlängerung."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Сохраните весь сад или отмените в любой момент до продления."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ponech si celou zahradu, nebo předplatné kdykoli před obnovením zruš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Håll hela trädgården eller avbryta när som helst innan den förnyas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Pidä koko puutarha tai peru milloin vain ennen uusimista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Houd de hele tuin of zeg altijd op vóór de verlenging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Conserva el jardín completo o cancela cuando quieras antes de la renovación."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Behold den fulde have, eller aflys når som helst før den fornyer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Zachowaj cały ogród albo anuluj w dowolnej chwili przed odnowieniem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Udržujte celú záhradu, alebo zrušiť kedykoľvek pred obnovením."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Behold hele hagen, eller avslutt når som helst før fornyelse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Păstrați grădina completă, sau anulați orice moment înainte de a reînnoi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Збережіть увесь сад або скасуйте будь-коли до подовження."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tieni tutto il giardino o annulla quando vuoi prima del rinnovo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@保留整所花园,或在续约前取消任何时间."
          }
        }
      }
    },
