    "Name a situation where I used to reach for a pouch. How did I navigate it?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a situation where I used to reach for a pouch. How did I navigate it?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In welcher Situation hätte ich früher zu einem Nikotinbeutel gegriffen? Wie bin ich damit umgegangen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В какой ситуации я раньше тянулся за никотиновым паучем и как я с этим справился?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V jaké situaci mě dříve napadlo sáhnout po nikotinovém sáčku? Jak se mi ji podařilo zvládnout?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv en situation då jag brukade ta en nikotinpåse. Hur tog jag mig igenom den?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaile tilanne, jossa otin ennen nikotiinipussin. Miten selvisin siitä?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf een situatie waarin je vroeger een nicotinezakje nam. Hoe kwam je er toen doorheen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piensa en una situación en la que antes buscabas una bolsita de nicotina. ¿Cómo la afrontaste?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv en situation, hvor du plejede at tage en nikotinpose. Hvordan kom du igennem den?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz sytuację, w której sięgasz po saszetkę nikotynową. Jak udaje ci się przez nią przejść?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opíš situáciu, v ktorej siahaš po nikotínovom vrecúšku. Čo ti pomôže ju zvládnuť?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv en situasjon der du pleide å ty til en nikotinpose. Hvordan kom du deg gjennom den?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrieți o situație în care obișnuiam să iau un pliculeț cu nicotină. Cum am gestionat-o?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишіть ситуацію, яка раніше спонукала мене взяти нікотиновий пакетик. Як мені вдалося з нею впоратися?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi una situazione in cui in passato cercavo una bustina di nicotina. Come ho fatto a superarla?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想想过去会拿起尼古丁袋的一个情境。我是怎么应对的？"
          }
        }
      }
    },
    "Nerve endings begin to recover.": {
      "extractionState": "manual",
