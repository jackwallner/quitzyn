            "value": "Вы держитесь уже три месяца!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už tři měsíce to zvládáte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre månader avklarade."
          }
        },
        "fi": {
