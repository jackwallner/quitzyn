    "It's already smaller than it was a minute ago, even if it doesn't feel finished.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's already smaller than it was a minute ago, even if it doesn't feel finished."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist schon kleiner als vor einer Minute, auch wenn es sich nicht vorbei anfühlt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она уже слабее, чем минуту назад, даже если кажется, что не прошла."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už je menší než před minutou, i když to ještě nepůsobí jako konec."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är redan mindre än det var en minut sedan, även om det inte känns färdigt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on jo pienempi kuin minuutti sitten, vaikkei se tunnu ohi olevan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is al kleiner dan een minuut geleden, ook al voelt het nog niet voorbij."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya es más pequeño que hace un minuto, aunque no parezca haber terminado."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er allerede mindre end for et minut siden, selvom den ikke føler sig færdig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest już mniejszy niż minutę temu, nawet jeśli nie czujesz, że minął."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už je menšia ako pred minútou, aj keď sa to nebude cítiť hotové."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er allerede mindre enn for et minutt siden, selv om det ikke føles over."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E deja mai mică decât era acum un minut, chiar dacă nu se simte terminată."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він уже слабший, ніж хвилину тому, навіть якщо здається, що не минув."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già più piccola di un minuto fa, anche se non sembra finita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它已经比一分钟前小, 即使它没有感觉完成。"
          }
        }
      }
    },
    "It's okay. A slip is part of a lot of journeys, and logging it keeps the rest of your record honest.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's okay. A slip is part of a lot of journeys, and logging it keeps the rest of your record honest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist okay. Ein Ausrutscher gehört zu vielen Wegen, und ihn einzutragen hält den Rest deiner Aufzeichnung ehrlich."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё в порядке. Срыв бывает на многих путях, а если его отметить, остальная история останется честной."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To je v pořádku. Uklouznutí patří k mnoha cestám a jeho zapsání udrží zbytek záznamu poctivý."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är okej. Många gör ett snedsteg längs vägen. Om du registrerar det förblir resten av din historik korrekt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei se mitään. Lipsahdus kuuluu monen matkaan, ja sen kirjaaminen pitää muun historian rehellisenä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is oké. Een uitglijder hoort bij veel reizen, en hem vastleggen houdt de rest van je geschiedenis eerlijk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está bien. Un desliz forma parte de muchos caminos, y registrarlo mantiene honesto el resto de tu historial."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er okay. Et fejltrin er en del af mange menneskers vej. Når du registrerer det, forbliver resten af din historik retvisende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W porządku. Potknięcie jest częścią wielu dróg, a zapisanie go sprawia, że reszta historii pozostaje uczciwa."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To je v poriadku. Zakopnutie patrí k mnohým cestám. Keď ho zaznamenáte, zvyšok histórie zostane presný."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er greit. En sprekk er en del av mange reiser, og å registrere den holder resten av historikken ærlig."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E în regulă. Mulți oameni au episoade de consum pe parcurs. Înregistrarea acestuia păstrează restul istoricului corect."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе гаразд. Зрив буває на багатьох шляхах, а якщо його позначити, решта історії залишиться чесною."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va bene. Uno scivolone fa parte di tanti percorsi, e registrarlo mantiene onesto il resto della tua cronologia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没关系。很多人的戒断过程中都会有一次失手。记录下来，可以让其余的记录保持准确。"
          }
        }
      }
    },
