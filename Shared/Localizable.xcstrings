    "Almost through. Whatever's left of it is on its way out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost through. Whatever's left of it is on its way out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast geschafft. Was noch da ist, klingt schon ab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяга почти прошла. Остаток скоро утихнет."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoro hotovo. Co z ní zbylo, už odchází."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snart över. Det som finns kvar är på väg ut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Melkein ohi. Loputkin ovat poistumassa elimistöstä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna voorbij. Wat er nog over is, verdwijnt ook."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya casi pasa. Lo que queda también está saliendo del cuerpo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er næsten overstået. Resten er også på vej ud af kroppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najgorsze już za tobą. Reszta też wkrótce minie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najhoršia časť je takmer za tebou. Aj to, čo zostalo, čoskoro pominie."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det verste er nesten over. Resten er også på vei ut."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproape a trecut. Ce a mai rămas este pe cale să dispară."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майже минуло. Те, що залишилося, вже відходить."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi finito. Quel che resta se ne sta andando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快到头了，剩下的尼古丁也快代谢完了。"
          }
        }
      }
    },
