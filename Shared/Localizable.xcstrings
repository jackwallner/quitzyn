            "state": "translated",
            "value": "Drażliwość i niepokój łagodnieją."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podráždenosť a úzkosť ustupujú."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Irritabilitet og uro avtar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Iritabilitatea și anxietatea se reduc."
          }
        },
        "uk": {
          "stringUnit": {
