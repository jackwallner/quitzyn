    "Free until %@. Turn on notifications and we'll remind you before your trial ends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free until %@. Turn on notifications and we'll remind you before your trial ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos bis %1$@. Aktiviere Mitteilungen, damit wir dich vor Ablauf der Testphase erinnern."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно до %1$@. Включите уведомления, и мы напомним вам до окончания пробного периода."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarma do %1$@. Zapni oznámení a připomeneme ti konec zkušební doby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis till %1$@. Slå på notiser så påminner vi dig innan provperioden tar slut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksuton %1$@ asti. Ota ilmoitukset käyttöön, niin muistutamme ennen kokeilujakson päättymistä."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis tot %1$@. Zet meldingen aan, dan herinneren we je voordat je proefperiode afloopt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis hasta el %1$@. Activa las notificaciones y te avisaremos antes de que termine el periodo de prueba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis indtil %1$@. Slå notifikationer til, så minder vi dig om det, før prøveperioden slutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatnie do %1$@. Włącz powiadomienia, a przypomnimy Ci przed końcem okresu próbnego."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarma do %1$@. Zapni upozornenia a pripomenieme ti koniec skúšobného obdobia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis til %1$@. Slå på varsler, så minner vi deg på det før prøveperioden er over."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit până la %1$@. Activează notificările și îți reamintim înainte de încheierea perioadei de probă."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовно до %1$@. Увімкніть сповіщення, і ми нагадаємо вам до завершення пробного періоду."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis fino al %1$@. Attiva le notifiche e ti avviseremo prima della fine del periodo di prova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费至%1$@。开启通知后，我们会在试用期结束前提醒你。"
          }
        }
      }
    },
