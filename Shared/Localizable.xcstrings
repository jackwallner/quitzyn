    "Notice it without arguing with it. You're not trying to win, you're waiting it out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice it without arguing with it. You're not trying to win, you're waiting it out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm es wahr, ohne mit ihm zu streiten. Du willst nicht gewinnen, du wartest es ab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замечайте её, не споря с ней. Вы не пытаетесь победить, вы её пережидаете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všímej si jí, ale nehádej se s ní. Nesnažíš se vyhrát, jen to přečkáváš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg märke till det utan att argumentera med det. Du försöker inte vinna, du väntar på det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huomaa se väittelemättä sen kanssa. Et yritä voittaa, vaan odotat sen ohi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk het op zonder ermee in discussie te gaan. Je wilt niet winnen, je wacht het af."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsérvalo sin discutir con él. No intentas ganar, solo esperas a que pase."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du prøver ikke at vinde, du venter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zauważ go, nie kłócąc się z nim. Nie próbujesz wygrać, tylko go przeczekujesz."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všimnite si to bez toho, aby ste sa s tým hádali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg merke til det uten å krangle med det. Du prøver ikke å vinne, du venter det ut."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu încerci să câştigi, aştepţi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помічайте його, не сперечаючись. Ви не намагаєтеся перемогти, ви його перечікуєте."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osservala senza discuterci. Non devi vincere, devi solo aspettare che passi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意不要争吵,你不是想赢 而是在等它出来"
          }
        }
      }
    },
    "Notifications are turned off for Quit Zyn, so the reminder can't be delivered. Tap above to enable them in the Settings app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off for Quit Zyn, so the reminder can't be delivered. Tap above to enable them in the Settings app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind für Quit Zyn deaktiviert, so dass die Erinnerung nicht zugestellt werden kann."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены для Quit Zyn, поэтому напоминание не может быть доставлено. Нажмите выше, чтобы включить их в приложении «Настройки»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou vypnuta pro Konec Zyn, takže upomínku nelze doručit. Klepněte na možnost výše v aplikaci Nastavení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelanden är avstängda för Quit Zyn, så påminnelsen kan inte levereras. Tryck ovan för att aktivera dem i appen Inställningar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset ovat pois päältä Quit Zyniä varten, joten muistutusta ei voida toimittaa. Napauta yllä, jotta ne voidaan ottaa käyttöön Asetukset -sovelluksessa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen worden uitgeschakeld voor het afsluiten van Zyn, zodat de herinnering niet kan worden geleverd. Tik op boven om ze in de instellingenapp in te schakelen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones se apagan para Quit Zyn, por lo que el recordatorio no se puede enviar. Pulse arriba para habilitarlos en la aplicación Ajustes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldelser slukkes for Afslut Zyn, så påmindelsen ikke kan leveres. Tryk på ovenfor for at aktivere dem i appen Indstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone dla Zakończ Zyn, więc przypomnienie nie może być dostarczone. Dotknij powyżej, aby włączyć je w aplikacji Ustawienia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenia sú vypnuté pre Quit Zyn, takže pripomienku nie je možné doručiť. Ťuknite vyššie, aby ste ich povolili v aplikácii Nastavenia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler slås av for Avslutt Zyn, slik at påminnelsen ikke kan leveres. Trykk på ovenfor for å aktivere dem i Innstillinger-appen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt oprite pentru Quit Zyn, astfel încât memento-ul nu poate fi livrat. Atingeți mai sus pentru a le activa în aplicația Setări."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення вимкнено для Quit Zyn, тому нагадування не може бути доставлено. Натисніть вище, щоб увімкнути їх у додатку Налаштування."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche vengono disattivate per Quit Zyn, quindi il promemoria non può essere consegnato. Tocca sopra per abilitarle nell'app Impostazioni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Quit Zyn 关闭通知, 因此无法发送提醒。 上方的 Tap 以在 Setting app 中启用 。"
          }
        }
      }
    },
