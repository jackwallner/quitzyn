          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stojí přibližně jako spotřeba nikotinových sáčků za den a půl."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostar ungefär lika mycket som portionssnus för en och en halv dag."
