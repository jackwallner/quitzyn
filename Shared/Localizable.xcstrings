          "stringUnit": {
            "state": "translated",
            "value": "Gendanner tælleren og træet til tilstanden før smutteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca licznik i drzewko do stanu sprzed potknięcia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vráti počítadlo a stromček do stavu pred pošmyknutím."
