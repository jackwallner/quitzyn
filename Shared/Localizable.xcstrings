    "The cascade style mimics a tree growing on a cliff, plunging downward.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cascade style mimics a tree growing on a cliff, plunging downward."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kaskadenstil ahmt einen Baum an einer Klippe nach, der nach unten stürzt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каскадный стиль напоминает дерево на скале, ниспадающее вниз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskádový styl napodobuje strom rostoucí na útesu, který se sklání dolů."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskadstilen efterliknar ett träd som växer på en klippa, sjunker nedåt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskadityyli jäljittelee jyrkänteellä kasvavaa, alas syöksyvää puuta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De cascadestijl bootst een boom na die op een klif groeit en naar beneden duikt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estilo cascada imita un árbol que crece en un acantilado y cae hacia abajo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskade stil efterligner et træ vokser på en klippe, styrter nedad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Styl kaskadowy naśladuje drzewo rosnące na klifie i opadające w dół."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskádový štýl napodobňuje strom, ktorý rastie na útese a vrhá sa dole."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaskadestilen etterligner et tre på en klippe som stuper nedover."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilul cascadei imită un copac care creşte pe o stâncă, cufundându-se în jos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Каскадний стиль нагадує дерево на скелі, що спадає донизу."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stile a cascata imita un albero che cresce su una scogliera, protendendosi verso il basso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
